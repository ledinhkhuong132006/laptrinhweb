@model List<_24DH1110883_MyStore.Models.ViewModel.CartItem>

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>GIỎ HÀNG (@(Model != null ? Model.Count : 0) sản phẩm)</h2>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-warning text-center">
            Giỏ hàng của bạn đang trống. <br />
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-2">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <table class="table table-bordered mt-3">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@item.ProductImage" width="50" style="margin-right:10px;" />
                            @item.ProductName
                        </td>
                        <td>@item.UnitPrice.ToString("N0")</td>
                        <td>
                            @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post))
                            {
                                <input type="hidden" name="id" value="@item.ProductID" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" style="width: 60px; text-align: center;" />
                                <button type="submit" class="btn btn-sm btn-info">Cập nhật</button>
                            }
                        </td>
                        <td style="font-weight:bold; color:red;">
                            @item.TotalPrice.ToString("N0")
                        </td>
                        <td>
                            <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductID })" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa không?');">Xóa</a>
                        </td>
                    </tr>
                }
                <tr>
                    <td colspan="3" class="text-right" style="text-align:right; font-weight:bold;">TỔNG CỘNG:</td>
                    <td colspan="2" style="font-weight:bold; color:red; font-size: 18px;">
                        @Model.Sum(x => x.TotalPrice).ToString("N0") đ
                    </td>
                </tr>
            </tbody>
        </table>

        <div class="text-right" style="text-align:right;">
            <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Tiếp tục mua hàng</a>
            <a href="@Url.Action("Checkout", "Order")" class="btn btn-success">TIẾN HÀNH THANH TOÁN</a>
        </div>
    }
</div>