@model _24DH1110883_MyStore.Models.ViewModel.HomeProductVM

<section class="mb-3">
    <div class="section-title mb-2">
        <h3 style="font-weight:bold; text-transform:uppercase; border-bottom: 2px solid #007bff; display:inline-block;">
            Sản phẩm nổi bật
        </h3>
        <a class="btn btn-sm btn-outline-secondary" href="#new-products" style="float:right;">Xem tất cả</a>
    </div>

    @if (Model != null && Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
    {
        <div class="list-container">
            @foreach (var product in Model.FeaturedProducts)
            {
                <div class="lproduct-item">
                    @* --- SỬA LỖI QUAN TRỌNG TẠI ĐÂY --- *@
                    @* 1. Sửa 'item' thành 'product' *@
                    @* 2. Thêm area = "" để không bị bay về Admin *@
                    @* 3. Đã đóng dấu ngoặc kép " bị thiếu *@
                    <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID, area = "" })">
                        @* Cập nhật đường dẫn ảnh cho đúng thư mục *@
                        <img src="@(product.ProductImage != null && product.ProductImage.Contains("http") ? product.ProductImage : Url.Content("~/images/products/" + product.ProductImage))" alt="@product.ProductName" />
                    </a>

                    <h5>
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID, area = "" })" style="text-decoration:none; color:inherit;">
                            @product.ProductName
                        </a>
                    </h5>

                    <span class="prodSale">@product.ProductPrice.ToString("N0") đ</span>

                    <div class="text-muted" style="font-size: 12px; margin: 5px 0;">
                        Đã bán: @(product.OrderDetails != null ? product.OrderDetails.Count : 0)
                    </div>

                    <div style="margin-top: auto; padding-top: 10px; border-top: 1px dashed #eee;">

                        @* Thêm area = "" cho nút Mua ngay để an toàn *@
                        <a class="btn btn-sm btn-danger" href="@Url.Action("AddToCart", "Cart", new { id = product.ProductID, area = "" })" style="margin-right: 5px;">
                            Mua ngay
                        </a>

                        @* Thêm area = "" cho nút Thêm giỏ để an toàn *@
                        <a class="btn btn-sm btn-warning" href="@Url.Action("AddToCart", "Cart", new { id = product.ProductID, area = "" })">
                            <i class="fa fa-cart-plus"></i> Thêm vào giỏ
                        </a>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">Không có sản phẩm nổi bật.</p>
    }
</section>