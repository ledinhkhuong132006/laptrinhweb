@model _24DH1110883_MyStore.Models.ViewModel.HomeProductVM
@using PagedList.Mvc

<section id="new-products" class="mb-3">
    <div class="section-title mb-2">
        <h3 style="font-weight:bold;
            text-transform:uppercase; 
            border-bottom: 2px solid #007bff; 
            display:inline-block;"  >Sản phẩm mới</h3>
    </div>

    @* Kiểm tra null an toàn *@
    @if (Model != null && Model.NewProducts != null && Model.NewProducts.Any())
    {
        @* Dùng class "list-container" để chia cột giống hệt Sản phẩm nổi bật *@
        <div class="list-container">
            @foreach (var product in Model.NewProducts)
            {
                @* Dùng class "lproduct-item" để khung giống hệt Sản phẩm nổi bật *@
                <div class="lproduct-item">
                    <a href="@Url.Action("ProductDetails", "Home", new { area = "Admin", id = product.ProductID })">
                        <img src="@Url.Content(product.ProductImage ?? "~/Content/img/no-image.png")" alt="@product.ProductName" />
                    </a>

                    <h5>@product.ProductName</h5>

                    <span class="prodSale">@product.ProductPrice.ToString("N0") đ</span>

                    @* (Tùy chọn) Hiển thị số lượng đã bán nhỏ ở dưới *@
                    <div class="text-muted" style="font-size: 12px; margin-top: 5px;">
                        Đã bán: @(product.OrderDetails != null ? product.OrderDetails.Count : 0)
                    </div>
                </div>
            }
        </div>

        @* Phần phân trang giữ nguyên *@
        <div class="d-flex justify-content-center mt-4">
            @Html.PagedListPager(Model.NewProducts, page => Url.Action("Index", "Home", new { area = "Admin", page, searchTerm = (Model != null ? Model.SearchTerm : "") }), PagedListRenderOptions.ClassicPlusFirstAndLast)
        </div>
    }
    else
    {
        <p class="text-muted">Không tìm được sản phẩm nào phù hợp.</p>
    }
</section>