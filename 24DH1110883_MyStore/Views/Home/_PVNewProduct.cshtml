@model _24DH1110883_MyStore.Models.ViewModel.HomeProductVM
@using PagedList.Mvc

<section id="new-products" class="mb-3">
    <div class="section-title mb-2">
        <h3 style="font-weight:bold; text-transform:uppercase; border-bottom: 2px solid #007bff; display:inline-block;">
            Sản phẩm mới
        </h3>
    </div>

    @if (Model != null && Model.NewProducts != null && Model.NewProducts.Any())
    {
        <div class="list-container">
            @foreach (var product in Model.NewProducts)
            {
                <div class="lproduct-item">
                    @* --- SỬA LỖI 1: Thay area="Admin" thành area="" --- *@
                    <a href="@Url.Action("ProductDetails", "Home", new { area = "", id = product.ProductID })">
                        @* Cập nhật đường dẫn ảnh cho đúng thư mục *@
                        <img src="@(product.ProductImage != null && product.ProductImage.Contains("http") ? product.ProductImage : Url.Content("~/images/products/" + product.ProductImage))" alt="@product.ProductName" />
                    </a>

                    <h5>
                        @* Link tên sản phẩm cũng phải sửa về area="" *@
                        <a href="@Url.Action("ProductDetails", "Home", new { area = "", id = product.ProductID })" style="text-decoration:none; color:inherit;">
                            @product.ProductName
                        </a>
                    </h5>

                    <span class="prodSale">@product.ProductPrice.ToString("N0") đ</span>

                    <div class="text-muted" style="font-size: 12px; margin: 5px 0;">
                        Đã bán: @(product.OrderDetails != null ? product.OrderDetails.Count : 0)
                    </div>

                    <div style="margin-top: auto; padding-top: 10px; border-top: 1px dashed #eee;">

                        @* Thêm area = "" cho nút Mua ngay *@
                        <a class="btn btn-sm btn-danger"
                           href="@Url.Action("AddToCart", "Cart", new { id = product.ProductID, quantity = 1, type = "buynow", area = "" })"
                           style="margin-right: 5px;">
                            Mua ngay
                        </a>

                        @* 2. Nút THÊM VÀO GIỎ (Thêm quantity=1 và type="normal") *@
                        <a class="btn btn-sm btn-warning"
                           href="@Url.Action("AddToCart", "Cart", new { id = product.ProductID, quantity = 1, type = "normal", area = "" })">
                            <i class="fa fa-cart-plus"></i> Thêm vào giỏ
                        </a>

                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-center mt-4">
            @* --- SỬA LỖI 2 (Quan trọng): Sửa area="Admin" thành area="" trong phân trang --- *@
            @Html.PagedListPager(Model.NewProducts,
                page => Url.Action("Index", "Home", new { area = "", page, searchTerm = (Model != null ? Model.SearchTerm : "") }),
                PagedListRenderOptions.ClassicPlusFirstAndLast)
        </div>
    }
    else
    {
        <p class="text-muted">Không tìm được sản phẩm nào phù hợp.</p>
    }
</section>