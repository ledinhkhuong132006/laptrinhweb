@model _24DH1110883_MyStore.Models.ViewModel.EditProfileVM
@{
    ViewBag.Title = "Cập nhật thông tin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 20px;">
    <h2>Cập nhật thông tin</h2>

    @using (Html.BeginForm("EditProfile", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.CustomerName, new { @class = "control-label fw-bold" })
                @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.CustomerEmail, new { @class = "control-label fw-bold" })
                @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control", type = "email" })
                @Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.CustomerPhone, new { @class = "control-label fw-bold" })
                @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CustomerPhone, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.CustomerAddress, new { @class = "control-label fw-bold" })
                @Html.TextBoxFor(m => m.CustomerAddress, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CustomerAddress, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-success">Lưu thay đổi</button>
                @Html.ActionLink("Hủy", "ProfileInfo", null, new { @class = "btn btn-secondary", style = "margin-left:10px;" })
            </div>
        </div>
    }
</div>