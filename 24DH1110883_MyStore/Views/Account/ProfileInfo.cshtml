@model _24DH1110883_MyStore.Models.Customer
@{
    ViewBag.Title = "Thông tin cá nhân"; // Đặt title tiếng Việt cho thân thiện
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 20px;">
    <h2>Thông tin tài khoản</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <table class="table table-bordered table-striped">
        <tr>
            <th style="width: 200px;">Tên đăng nhập</th>
            <td>@Model.Username</td>
        </tr>
        <tr>
            <th>Họ và tên</th>
            <td>@Model.CustomerName</td>
        </tr>
        <tr>
            <th>Email</th>
            <td>@Model.CustomerEmail</td>
        </tr>
        <tr>
            <th>Số điện thoại</th>
            <td>@Model.CustomerPhone</td>
        </tr>
        <tr>
            <th>Địa chỉ</th>
            <td>@Model.CustomerAddress</td>
        </tr>
    </table>

    <div class="mt-3">
        @Html.ActionLink("Sửa thông tin", "EditProfile", "Account", null, new { @class = "btn btn-primary" })
        @Html.ActionLink("Đổi mật khẩu", "ChangePassword", "Account", null, new { @class = "btn btn-warning", style = "margin-left:10px;" })
    </div>
</div>