@model _24DH1110883_MyStore.Models.Product

@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div>
    <h4>Product</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>Tên sản phẩm</dt>
        <dd>
            @Html.DisplayFor(model => model.ProductName)
        </dd>

        <dt>Giá sản phẩm</dt>
        <dd>
            @Html.DisplayFor(model => model.ProductPrice)
        </dd>

        <dt>Hình ảnh</dt>
        <dd>
            @Html.DisplayFor(model => model.ProductImage)
        </dd>

        <dt>Mô tả</dt>
        <dd>
            @Html.DisplayFor(model => model.ProductDescription)
        </dd>

        <dt>Danh mục sản phẩm</dt>
        <dd>
            @Html.DisplayFor(model => model.Category.CategoryName)
        </dd>
    </dl>
</div>
<p>
    @Html.ActionLink("Sửa", "Edit", new { id = Model.ProductID }, new {@class="btn btn-primary"}) |
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-primary" })
</p>
