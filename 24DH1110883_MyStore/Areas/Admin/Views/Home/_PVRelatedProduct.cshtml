@model _24DH1110883_MyStore.Models.ViewModel.ProductDetailsVM
@using PagedList.Mvc

<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />

@if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
{
    <section class="container-fluid featureProd">
        <h4 style="font-weight:bold;">Sản phẩm tương tự</h4>
        <ul class="feature-container list-unstyled d-flex flex-wrap">
            @foreach (var product in Model.RelatedProducts)
            {
                <li class="fproduct-item m-2" style="width:140px;">
                    <div>
                        <a href="@Url.Action("ProductDetails", "Home", new { area = "Admin", id = product.ProductID })">
                            <img src="@Url.Content(product.ProductImage ?? "~/Content/img/no-image.png")" alt="@product.ProductName" style="width:100%; height:100px; object-fit:cover;" />
                        </a>
                    </div>
                    <div>
                        <h5 style="font-size:0.9rem;">@product.ProductName</h5>
                        <p class="prodSale">@product.ProductPrice.ToString("C")</p>
                    </div>
                </li>
            }
        </ul>

        <div class="mt-2">
            @Html.PagedListPager(Model.RelatedProducts, page => Url.Action("ProductDetails", "Home", new { area = "Admin", id = Model.product.ProductID, quantity = Model.quantity, page }))
        </div>
    </section>
}
else
{
    <p class="text-muted">Không có sản phẩm tương tự.</p>
}