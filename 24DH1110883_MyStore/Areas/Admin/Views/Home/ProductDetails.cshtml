@model _24DH1110883_MyStore.Models.ViewModel.ProductDetailsVM
@{
    ViewBag.Title = "ProductDetails";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .pro {
        padding: 50px 10px;
        background-color: ghostwhite;
    }

    .pro-section {
        background-color: white;
        border: 1px groove #ffffff;
        border-radius: 10px;
        margin: 10px;
    }

        .pro-section img {
            max-height: 250px;
            max-width: 200px;
            padding: 5px;
            object-fit: cover;
        }

    .pro-price {
        font-weight: bolder;
        font-size: larger;
        color: red;
    }

    .pro-sale {
        font-weight: lighter;
    }

    .tab-pane {
        padding-top: 10px;
    }
</style>

<div class="container-fluid pro">
    <div class="row">
        <div class="col-md-3 pro-section">
            <img src="@Url.Content(Model.product.ProductImage ?? "~/Content/img/no-image.png")" alt="@Model.product.ProductName" />
        </div>

        <div class="col-md-5 pro-section">
            <h4><strong>@Html.DisplayFor(m => m.product.ProductName)</strong></h4>
            <p class="pro-sale">Đã bán: @(Model.product.OrderDetails != null ? Model.product.OrderDetails.Count : 0)</p>
            <p class="pro-price">@Model.product.ProductPrice.ToString("C")</p>
         
            <hr />
            <h5><strong>Mô tả</strong></h5>
            <p>@Model.product.ProductDescription</p>
            <hr />

            @* Tabs for related/top products *@
            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="related-tab" data-toggle="tab" href="#related" role="tab" aria-controls="related" aria-selected="true">Sản phẩm tương tự</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="top-tab" data-toggle="tab" href="#top" role="tab" aria-controls="top" aria-selected="false">Sản phẩm bán chạy</a>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="related" role="tabpanel" aria-labelledby="related-tab">
                    @Html.Partial("_PVRelatedProduct", Model)
                </div>
                <div class="tab-pane fade" id="top" role="tabpanel" aria-labelledby="top-tab">
                    @Html.Partial("_PVTopProduct", Model)
                </div>
            </div>
        </div>

        <div class="col-md-3 pro-section">
            <div class="form-group">
                @using (Html.BeginForm("ProductDetails", "Home", new { area = "Admin" }, FormMethod.Get))
                {
                    <h4>Số lượng</h4>
                    <p>
                        @Html.TextBoxFor(m => m.quantity, new { @class = "form-control", type = "number", min = "1" })
                    </p>

                    <h4>Tạm tính</h4>
                    <p>@(Model.estimatedValue.ToString("N0"))</p>

                    <p>
                        @Html.ActionLink("Thêm vào giỏ hàng", "AddToCart", "Cart",
                                 new { area = "Admin", id = Model.product.ProductID, quantity = Model.quantity },
                                 new { @class = "btn btn-info" })
                    </p>
                }
                <hr />
            </div>

            <div>
                @* You can reuse the top products or other widget here *@
                @Html.Partial("_PVTopProduct", Model)
            </div>
        </div>
    </div>
</div>
