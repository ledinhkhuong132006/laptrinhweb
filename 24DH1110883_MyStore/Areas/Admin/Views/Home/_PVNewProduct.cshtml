@model _24DH1110883_MyStore.Models.ViewModel.HomeProductVM
@using PagedList.Mvc

<section id="new-products" class="mb-3">
    <div class="section-title mb-2">
        <h3>Sản phẩm mới</h3>
    </div>

    @if (Model?.NewProducts != null && Model.NewProducts.Any())
    {
        <div class="row">
            @foreach (var product in Model.NewProducts)
            {
                <div class="col-6 col-sm-4 col-md-3 mb-3">
                    <div class="card h-100 admin-card">
                        <a href="@Url.Action("Details", "Home", new { area = "Admin", id = product.ProductID })" class="text-decoration-none text-dark">
                            <img class="card-img-top" src="@Url.Content(product.ProductImage ?? "~/Content/img/no-image.png")" alt="@product.ProductName" />
                            <div class="card-body p-2">
                                <div class="card-title">@product.ProductName</div>
                                <div class="card-price">@product.ProductPrice.ToString("C")</div>
                                <div class="text-muted" style="font-size:0.85rem;">Đã bán: @(product.OrderDetails != null ? product.OrderDetails.Count : 0)</div>
                            </div>
                        </a>
                        <div class="card-footer p-2">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", "Products", new { area = "Admin", id = product.ProductID })">Sửa</a>
                            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Details", "Products", new { area = "Admin", id = product.ProductID })">Chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-center">
            @Html.PagedListPager(Model.NewProducts, page => Url.Action("Index", "Home", new { area = "Admin", page, searchTerm = Model.SearchTerm }), PagedListRenderOptions.ClassicPlusFirstAndLast)
        </div>
    }
    else
    {
        <p class="text-muted">Không tìm được sản phẩm nào phù hợp.</p>
    }
</section>