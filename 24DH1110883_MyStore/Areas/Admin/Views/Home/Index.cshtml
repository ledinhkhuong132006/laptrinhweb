@using _24DH1110883_MyStore.ViewModels
@model IEnumerable<ProductStatisticVM>

@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; // Đường dẫn layout của bạn
}

<div class="container-fluid">
    <h2 class="mt-4">Thống Kê Sản Phẩm Bán Chạy</h2>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Top 5 Sản Phẩm
        </div>
        <div class="card-body">
            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                     
                        <th>Tên sản phẩm</th>
                        <th>Số lượng đã bán</th>
                        <th>Doanh thu mang lại</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                             
                                <td>@item.TenSanPham</td>
                                <td style="font-weight: bold; color: green;">@item.SoLuongDaBan</td>
                                <td>@string.Format("{0:N0} đ", item.TongDoanhThu)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">Chưa có dữ liệu đơn hàng</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>