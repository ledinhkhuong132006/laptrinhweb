@model _24DH1110883_MyStore.Models.ViewModel.HomeProductVM

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-3">Trang quản trị</h2>

<style>
  
    .admin-card {
        max-width: 220px;
    }

        .admin-card img {
            height: 150px;
            object-fit: cover;
        }

    .featured-row {
        overflow-x: auto;
        white-space: nowrap;
        padding-bottom: 10px;
    }

    .featured-item {
        display: inline-block;
        margin-right: 12px;
        vertical-align: top;
    }

    .card-title {
        font-size: 0.95rem;
        font-weight: 600;
    }

    .card-price {
        color: #28a745;
        font-weight: 700;
    }

    .section-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .section-title h3 {
            margin: 0;
        }
</style>

@using (Html.BeginForm("Index", "Home", new { area = "Admin" }, FormMethod.Get))
{
    <div class="form-inline mb-3">
        @Html.TextBoxFor(m => m.SearchTerm, new { @class = "form-control mr-2", placeholder = "Tìm kiếm sản phẩm..." })
        <button type="submit" class="btn btn-primary">Tìm</button>
    </div>
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            @Html.Partial("_PVFeatureProduct", Model)
        </div>
    </div>

    <hr />

    <div class="row">
        <div class="col-12">
            @Html.Partial("_PVNewProduct", Model)
        </div>
    </div>
</div>