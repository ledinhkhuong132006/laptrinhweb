@model  _24DH1110883_MyStore.Models.ViewModel.ProductSearchVM

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<html>

<head>
    <meta name="viewport" content="width=device-width"/>
    <title>Search</title>
    <style>
        .search-container, .order-container {
            padding-top: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
    </style>
</head>
<body>
    <!-- Search Form tìm kiếm -->
    @using (Html.BeginForm("Index", "Products", FormMethod.Get))
    {
        <div class="form-group search-container">
            @Html.TextBoxFor(m => m.SearchTerm, new
       {
           @class = "form-control",
           placeholder = "Nhập tên sản phẩm cần tìm"
       })


            @Html.TextBoxFor(m => m.MinPrice, new
       {
           @class = "form-control",
           placeholder = "Giá tối thiểu",
           type = "number",
       })

            @Html.TextBoxFor(m => m.MaxPrice, new
       {
           @class = "form-control",
           placeholder = "Giá tối đa",
           type = "number",
       })



                 
            
           <button type = "submit" class=" btn btn-primary">Tìm Kiếm</button>
        </div>
        // tùy chọn sắp xếp
<div class=" form-group order-container">
    Sắp xếp theo:
    @Html.ActionLink("Tên tăng dần", "Index", new { sortOrder = "name_asc", searchTerm = Model.SearchTerm }) |
    @Html.ActionLink("Tên giảm dần", "Index", new { sortOrder = "name_asc", searchTerm = Model.SearchTerm }) |
    @Html.ActionLink("Giá tăng dần", "Index", new { sortOrder = "name_asc", searchTerm = Model.SearchTerm }) |
    @Html.ActionLink("Giá giảm dần", "Index", new { sortOrder = "name_asc", searchTerm = Model.SearchTerm })
</div>
        
    }
        @* form ket qua tim*@
@Html.Partial("PVListProduct", Model)
</body>
</html>
