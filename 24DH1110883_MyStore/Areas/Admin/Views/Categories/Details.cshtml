@model _24DH1110883_MyStore.Models.Category

@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Thông tin chi tiết của danh mục </h2>

<div>

    <hr />
    <dl class="dl-horizontal">
        <dt>
            @* @Html.DisplayNameFor(model => model.CategoryName)*@
            Tên danh mục 
        </dt>
        @* giá trị trường categoryname *@
        <dd>
            @Html.DisplayFor(model => model.CategoryName)
        </dd>

    </dl>
</div>
<p>
    @Html.ActionLink("Cập nhật", "Edit", new { id = Model.CategoryID}, new { @class = "btn btn-primary" })
    @Html.ActionLink("Quay lại danh sách", "Index" , null, new { @class = "btn btn-primary" })
</p>
