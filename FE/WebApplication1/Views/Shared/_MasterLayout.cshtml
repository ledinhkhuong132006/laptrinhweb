
@{
    ViewBag.Title = "_MasterLayout";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thanh toán - TechPhone</title>
    <link rel="stylesheet" href="assets/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            line-height: 1.6;
            background-color: gray;
            color: dimgray;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        a {
            text-decoration: none;
            color: white;
        }

        ul {
            list-style: none;
        }

        .site-header {
            background-color: black;
            color: white;
            padding: 20px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .site-header .container {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 20px;
            }

        .header-logo a {
            font-size: 28px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .header-search {
            display: flex;
            border: 1px solid #555;
            border-radius: 20px;
            overflow: hidden;
            background-color: #fff;
        }

            .header-search input {
                border: none;
                padding: 10px 15px;
                font-size: 14px;
                outline: none;
                width: 300px;
                color: #333;
            }

            .header-search button {
                background-color: lightblue;
                border: none;
                color: white;
                padding: 0 15px;
                cursor: pointer;
                font-size: 16px;
            }

        .header-nav {
            display: flex;
            align-items: center;
            gap: 35px;
        }

            .header-nav ul {
                display: flex;
                gap: 35px;
            }

            .header-nav a {
                font-size: 14px;
                font-weight: 600;
                text-transform: uppercase;
                color: lightgray;
                transition: color 0.3s ease;
            }

                .header-nav a:hover, .header-nav a.active {
                    color: white;
                }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 25px;
            font-size: 20px;
        }

            .header-actions a {
                color: white;
                transition: color 0.3s ease;
            }

                .header-actions a:hover {
                    color: cornflowerblue;
                }

        .footer {
            background-color: #24262b;
            color: #bbbbbb;
            padding: 30px 0 0;
            font-size: 14px;
        }

        .footer-container {
            max-width: 1100px;
            margin: auto;
            padding: 0 20px;
        }

        .footer-row {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: nowrap;
        }

        .footer-col {
            flex: 1;
            min-width: 250px;
        }

            .footer-col h4 {
                font-size: 15px;
                color: #ffffff;
                margin-bottom: 15px;
                font-weight: 600;
                position: relative;
            }

                .footer-col h4::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    bottom: -6px;
                    background-color: #e91e63;
                    height: 2px;
                    width: 35px;
                }

            .footer-col p {
                margin-bottom: 8px;
                line-height: 1.6;
            }

            .footer-col ul {
                list-style: none;
                padding: 0;
            }

                .footer-col ul li a,
                .footer-col ul li {
                    color: #bbbbbb;
                    text-decoration: none;
                    transition: 0.3s;
                    cursor: pointer;
                }

                    .footer-col ul li a:hover {
                        color: #ffffff;
                        padding-left: 5px;
                    }

        .social-links a {
            display: inline-block;
            height: 32px;
            width: 32px;
            background-color: rgba(255, 255, 255, 0.2);
            margin: 0 5px 5px 0;
            text-align: center;
            line-height: 32px;
            border-radius: 50%;
            transition: 0.3s ease;
        }

            .social-links a:hover {
                background-color: #ffffff;
                color: #24262b;
            }

        .footer-bottom {
            text-align: center;
            padding: 10px 0;
            margin-top: 20px;
            border-top: 1px solid #3c3c3c;
            font-size: 13px;
            color: #888888;
        }
    </style>
</head>
<body>
    <header class="site-header">
        <div class="container">
            <div class="header-logo"><a href="/Home/trangchu">TechPhone</a></div>

            <div class="header-search">
                <input type="text" placeholder="Tìm kiếm sản phẩm...">
                <button type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
            </div>

            <nav class="header-nav">
                <ul>
                    <li><a href="/Home/trangchu">Trang Chủ</a></li>
                    <li><a href="/Home/trangsanpham">Sản Phẩm</a></li>
                    <li><a href="/Home/tranglienhe">Liên Hệ</a></li>
                </ul>
            </nav>

            <div class="header-actions">
                <a href="/Home/thongtin" aria-label="Tài khoản"><i class="fa-solid fa-user"></i></a>
                <a href="/Home/tranggiohang" aria-label="Giỏ hàng"><i class="fa-solid fa-cart-shopping"></i></a>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-container">
            <div class="footer-row">
                <div class="footer-col">
                    <h4>Về TechPhone</h4>
                    <p>TechPhone chuyên cung cấp sản phẩm di động và phụ kiện chính hãng với giá tốt và dịch vụ hậu mãi uy tín.</p>
                </div>

                <div class="footer-col">
                    <h4>Liên kết nhanh</h4>
                    <ul>
                        <li>Trang chủ</li>
                        <li>Sản phẩm</li>
                        <li>Giới thiệu</li>
                        <li>Chính sách bảo hành</li>
                        <li>Điều khoản dịch vụ</li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Thông tin liên hệ</h4>
                    <ul>
                        <li><i class="fa-solid fa-map-marker-alt"></i> 246 CMT8, Phường 9, Q3, TPHCM</li>
                        <li><i class="fa-solid fa-phone"></i> (+84)708597314</li>
                        <li><i class="fa-solid fa-envelope"></i> support@techphone.com</li>
                    </ul>
                    <div class="social-links">
                        <a href="#"><i class="fa-brands fa-facebook"></i></a>
                        <a href="#"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#"><i class="fa-brands fa-twitter"></i></a>
                        <a href="#"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2025 TechPhone. All Rights Reserved.</p>
        </div>
    </footer>
</body>
</html>