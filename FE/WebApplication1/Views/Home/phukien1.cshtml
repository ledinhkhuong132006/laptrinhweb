                color: #999;
            }

        .product-detail-section {
            padding: 40px 0;
            background-color: white;
        }

        .product-detail-container {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 50px;
            align-items: flex-start;
        }

        .product-images {
