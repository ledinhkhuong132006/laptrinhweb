            margin-bottom: 10px;
            font-weight: 600;
        }

        .option-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

            .option-buttons .option-btn {
                padding: 8px 15px;
                border: 1px solid;
                border-radius: 20px;
                cursor: pointer;
                transition: all 0.3s;
                font-size: 14px;
                display: flex;
                align-items: center;
            }

                .option-buttons .option-btn:hover {
                    background-color: white;
                    border-color: gray;
                }

                .option-buttons .option-btn.active {
                    background-color: dodgerblue;
                    color: #fff;
                    border-color: dodgerblue;
                }

        .option-btn .color-swatch {
            display: inline-block;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            margin-right: 8px;
            border: 1px solid #ddd;
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            border: 1px solid white;
            border-radius: 5px;
            width: fit-content;
        }

            .quantity-selector button {
                background: white;
                border: none;
                width: 35px;
                height: 35px;
                font-size: 20px;
                cursor: pointer;
            }

            .quantity-selector input {
                width: 50px;
                height: 35px;
                text-align: center;
                border: none;
                border-left: 1px solid white;
                border-right: 1px solid white;
                font-size: 16px;
                -moz-appearance: textfield;
            }

                .quantity-selector input::-webkit-outer-spin-button,
                .quantity-selector input::-webkit-inner-spin-button {
                    -webkit-appearance: none;
                    margin: 0;
                }

        .product-actions {
            margin-top: 30px;
            display: flex;
            gap: 15px;
        }

            .product-actions .btn-primary {
                flex-grow: 1;
                padding: 15px;
                font-size: 16px;
            }

        .product-tabs-section {
            padding: 60px 0;
        }

