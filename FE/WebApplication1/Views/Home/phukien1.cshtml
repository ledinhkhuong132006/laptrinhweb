            display: flex;
            border-bottom: 1px solid white;
            margin-bottom: 30px;
        }

        .tab-link {
            padding: 15px 30px;
            cursor: pointer;
            font-size: 18px;
            font-weight: 600;
            color: dimgrey;
            position: relative;
            border-bottom: 3px solid transparent;
            transition: all 0.3s;
        }

            .tab-link.active {
                color: lightblue;
                border-bottom-color: lightblue;
            }

        .tab-content {
            display: none;
        }

            .tab-content.active {
                display: block;
            }

            .tab-content h3 {
                font-size: 20px;
                margin-bottom: 15px;
            }

            .tab-content p, .tab-content li {
                color: black;
                margin-bottom: 10px;
            }

        .specs-table {
            width: 100%;
            border-collapse: collapse;
        }

            .specs-table td {
                padding: 12px;
                border-bottom: 1px solid white;
            }

                .specs-table td:first-child {
                    font-weight: 600;
                    width: 30%;
                    background-color: white;
                }

        .related-products {
            padding-bottom: 60px;
        }

        .section-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 30px;
            text-transform: uppercase;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
        }

        .product-card {
            background-color: white;
            border: 1px solid white;
            padding: 20px;
            text-align: center;
