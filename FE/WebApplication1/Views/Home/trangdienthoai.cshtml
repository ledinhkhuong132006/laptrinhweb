@{
    ViewBag.Title = "trangdienthoai";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechPhone - Điện thoại</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            line-height: 1.6;
            background-color: gray;
            color: dimgray;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        a {
            text-decoration: none;
            color: white;
        }

        ul {
            list-style: none;
        }

        .breadcrumbs {
            padding: 20px 0;
            background-color: white;
            border-bottom: 1px solid #e9e9e9;
        }

            .breadcrumbs ul {
                display: flex;
                gap: 10px;
                font-size: 14px;
            }

            .breadcrumbs a {
                color: cornflowerblue;
            }

            .breadcrumbs li {
                color: #333;
            }

                .breadcrumbs li:not(:last-child)::after {
                    content: '/';
                    margin-left: 10px;
                    color: #999;
                }

        .featured-products {
            padding: 60px 0;
            text-align: center;
        }

        .section-title {
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 40px;
            text-transform: uppercase;
            position: relative;
        }

            .section-title::after {
                content: '';
                position: absolute;
                bottom: -10px;
                left: 50%;
                transform: translateX(-50%);
                width: 60px;
                height: 3px;
                background-color: deepskyblue;
            }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
        }

        .product-card {
            background-color: white;
            border: 1px solid #e0e0e0;
            padding: 20px;
            text-align: center;
            transition: box-shadow 0.3s ease, transform 0.3s ease;
        }

            .product-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
            }

            .product-card img {
                max-width: 100%;
                height: auto;
                margin-bottom: 15px;
            }

        .product-name {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 10px;
            color: #333;
        }

        .product-rating {
            color: gold;
            margin-bottom: 10px;
        }

            .product-rating span {
                color: #666;
                font-size: 14px;
            }

        .product-price {
            font-size: 18px;
            font-weight: 700;
            color: black;
        }
    </style>
</head>
<body>
    <main>
        <section class="breadcrumbs">
            <div class="container">
                <ul>
                    <li><a href="/Home/trangchu">Trang chủ</a></li>
                    <li>Điện thoại</li>
                </ul>
            </div>
        </section>

        <section class="featured-products">
            <div class="container">
                <h2 class="section-title">Điện Thoại Nổi Bật</h2>
                <div class="product-grid">
                    <a href="/Home/trangsanpham1" class="product-card-link">
                        <div class="product-card">
                            <img src="https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-blue-thumbnew-600x600.jpg" alt="iPhone 15 Pro" />
                            <h3 class="product-name">iPhone 15 Pro</h3>
                            <div class="product-rating">
                                <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star-half-alt"></i>
                                <span>(125 đánh giá)</span>
                            </div>
                            <p class="product-price">28.990.000₫</p>
                        </div>
                    </a>

                    <a href="/Home/trangsanpham2" class="product-card-link">
                        <div class="product-card">
                            <img src="https://cdn2.cellphones.com.vn/insecure/rs:fill:0:358/q:90/plain/https://cellphones.com.vn/media/catalog/product/d/i/dien-thoai-samsung-galaxy-s25-ultra_2__4.png" alt="Galaxy S25 Ultra">
                            <h3 class="product-name">Galaxy S25 Ultra</h3>
                            <div class="product-rating">
                                <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                                <span>(125 đánh giá)</span>
                            </div>
                            <p class="product-price">32.000.000₫</p>
                        </div>
                    </a>

                    <a href="/Home/trangsanpham3" class="product-card-link">
                        <div class="product-card">
                            <img src="https://cdn.tgdd.vn/2025/10/timerseo/322129-600x600-2.jpg" alt="Oppo Find X8 Pro">
                            <h3 class="product-name">Oppo Find X8 Pro</h3>
                            <div class="product-rating">
                                <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star-half-alt"></i>
                                <span>(98 đánh giá)</span>
                            </div>
                            <p class="product-price">24.990.000₫</p>
                        </div>
                    </a>

                    <a href="/Home/trangsanpham4" class="product-card-link">
                        <div class="product-card">
                            <img src="https://cdn.tgdd.vn/Products/Images/42/341625/vivo-v60-5g-xam-thumb-600x600.jpg" alt="Vivo V60 5G">
                            <h3 class="product-name">Vivo V60 5G</h3>
                            <div class="product-rating">
                                <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star-half-alt"></i>
                                <span>(85 đánh giá)</span>
                            </div>
                            <p class="product-price">19.990.000₫</p>
                        </div>
                    </a>

                    <a href="/Home/trangsanpham5" class="product-card-link">
                        <div class="product-card">
                            <img src="https://cdn.tgdd.vn/Products/Images/42/344644/xiaomi-15t-rose-gold-thumb-600x600.jpg" alt="Xiaomi 15T 5G">
                            <h3 class="product-name">Xiaomi 15T 5G</h3>
                            <div class="product-rating">
                                <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star-half-alt"></i>
                                <span>(110 đánh giá)</span>
                            </div>
                            <p class="product-price">22.990.000₫</p>
                        </div>
                    </a>
                </div>
            </div>
        </section>
    </main>
</body>
</html>