@{
    ViewBag.Title = "tranggiao";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giao hàng - TechPhone</title>
    <link rel="stylesheet" href="style.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
            margin: 0;
        }

        header {
            background-color: #000;
            color: white;
            padding: 15px 50px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            header h1 {
                font-size: 22px;
                letter-spacing: 1px;
            }

        .progress {
            display: flex;
            justify-content: center;
            margin: 30px auto;
            gap: 15px;
        }

        .step {
            width: 130px;
            text-align: center;
            font-size: 14px;
            color: #999;
            position: relative;
        }

            .step::before {
                content: "";
                position: absolute;
                top: 8px;
                left: -65px;
                width: 60px;
                height: 2px;
                background-color: #ccc;
            }

            .step:first-child::before {
                display: none;
            }

        .active {
            color: #0071e3;
            font-weight: bold;
        }

        .step.active::before {
            background-color: #0071e3;
        }

        .container {
            width: 60%;
            margin: 0 auto;
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            padding: 30px;
        }

            .container h2 {
                margin-bottom: 20px;
                color: #333;
                border-bottom: 2px solid #0071e3;
                padding-bottom: 10px;
            }

        form label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
        }

        form input, form select, form textarea {
            width: 100%;
            padding: 10px;
            margin-bottom: 20px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 14px;
            box-sizing: border-box;
        }

        .btn {
            background-color: #0071e3;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 6px;
            font-size: 15px;
            cursor: pointer;
            transition: 0.3s;
            width: 100%;
        }

            .btn:hover {
                background-color: #005bb5;
            }

        footer {
            text-align: center;
            color: #777;
            font-size: 13px;
            padding: 20px;
            background-color: #f1f1f1;
            margin-top: 40px;
        }
    </style>
</head>
<body>
    <header>
        <h1>TECHPHONE</h1>
        <nav>
            <a href="/Home/Index" style="color:white; margin-right:20px;">Trang chủ</a>
            <a href="/Home/Cart" style="color:white;">Giỏ hàng</a>
        </nav>
    </header>

    <div class="progress">
        <div class="step">Giỏ hàng</div>
        <div class="step active">Giao hàng</div>
        <div class="step">Thanh toán</div>
        <div class="step">Xác nhận</div>
    </div>

    <div class="container">
        <h2>Thông tin giao hàng</h2>

        <form id="shippingForm">
            <label for="fullname">Họ và tên người nhận</label>
            <input type="text" id="fullname" name="fullname" required placeholder="Nguyễn Văn A">

            <label for="phone">Số điện thoại</label>
            <input type="tel" id="phone" name="phone" required placeholder="0123 456 789">

            <label for="address">Địa chỉ giao hàng</label>
            <textarea id="address" name="address" rows="3" required placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố"></textarea>

            <label for="note">Ghi chú (nếu có)</label>
            <textarea id="note" name="note" rows="2" placeholder="Ví dụ: Giao giờ hành chính, gọi trước khi đến..."></textarea>

            <label for="method">Phương thức giao hàng</label>
            <select id="method" name="method">
                <option>Giao hàng tiêu chuẩn (2-4 ngày)</option>
                <option>Giao nhanh (trong 24h)</option>
                <option>Nhận tại cửa hàng</option>
            </select>

            <button type="button" class="btn" onclick="nextStep()">Tiếp tục thanh toán</button>
        </form>
    </div>

    <footer>
        © 2025 TechPhone.
    </footer>

    <script>
        function nextStep() {
            const name = document.getElementById('fullname').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const address = document.getElementById('address').value.trim();

            if (!name || !phone || !address) {
                alert("Vui lòng nhập đầy đủ thông tin giao hàng!");
                return;
            }

            const shippingInfo = { name, phone, address };
            localStorage.setItem('shippingInfo', JSON.stringify(shippingInfo));

            window.location.href = "/Home/trangthanhtoan";
        }
    </script>
</body>
</html>