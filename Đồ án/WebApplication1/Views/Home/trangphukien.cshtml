@{
    ViewBag.Title = "trangphukien";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechPhone - Phụ kiện</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            line-height: 1.6;
            background-color: gray;
            color: dimgray;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        a {
            text-decoration: none;
            color: white;
        }

        ul {
            list-style: none;
        }

        /* --- CSS CHO HEADER (ĐÃ ĐƯỢC ĐỒNG BỘ) --- */
        .site-header {
            background-color: black;
            color: white;
            padding: 20px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .site-header .container {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 20px;
            }

        .header-logo a {
            font-size: 28px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .header-search {
            display: flex;
            border: 1px solid #555;
            border-radius: 20px;
            overflow: hidden;
            background-color: #fff;
        }

            .header-search input {
                border: none;
                padding: 10px 15px;
                font-size: 14px;
                outline: none;
                width: 300px;
                color: #333;
            }

            .header-search button {
                background-color: lightblue;
                border: none;
                color: white;
                padding: 0 15px;
                cursor: pointer;
                font-size: 16px;
            }

        .header-nav {
            display: flex;
            align-items: center;
            gap: 35px;
        }

            .header-nav ul {
                display: flex;
                gap: 35px;
            }

            .header-nav a {
                font-size: 14px;
                font-weight: 600;
                text-transform: uppercase;
                color: lightgray;
                transition: color 0.3s ease;
            }

                .header-nav a:hover, .header-nav a.active { /* Thêm .active để làm nổi bật trang hiện tại */
                    color: white;
                }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 25px;
            font-size: 20px;
        }

            .header-actions a {
                color: white;
                transition: color 0.3s ease;
            }

                .header-actions a:hover {
                    color: cornflowerblue;
                }

        .header-delivery {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #ccc;
            border-left: 1px solid #444;
            padding-left: 20px;
        }

            .header-delivery i {
                color: cornflowerblue;
            }

            .header-delivery .delivery-text {
                color: #fff;
                text-decoration: underline;
                cursor: pointer;
            }

        /* --- CSS RIÊNG CỦA TRANG PHỤ KIỆN --- */
        .breadcrumbs {
            padding: 20px 0;
            background-color: white;
            border-bottom: 1px solid #e9e9e9;
        }

            .breadcrumbs ul {
                display: flex;
                gap: 10px;
                font-size: 14px;
            }

            .breadcrumbs a {
                color: cornflowerblue; /* Đổi màu cho đẹp hơn */
            }

            .breadcrumbs li {
                color: #333; /* Thêm màu cho mục cuối */
            }

                .breadcrumbs li:not(:last-child)::after {
                    content: '/';
                    margin-left: 10px;
                    color: #999;
                }

        .featured-products {
            padding: 60px 0;
            text-align: center;
        }

        .section-title {
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 40px;
            text-transform: uppercase;
            position: relative;
        }

            .section-title::after {
                content: '';
                position: absolute;
                bottom: -10px;
                left: 50%;
                transform: translateX(-50%);
                width: 60px;
                height: 3px;
                background-color: deepskyblue;
            }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
        }

        .product-card {
            background-color: white;
            border: 1px solid #e0e0e0; /* Sửa màu viền */
            padding: 20px;
            text-align: center;
            transition: box-shadow 0.3s ease, transform 0.3s ease;
        }

            .product-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
            }

            .product-card img {
                max-width: 100%;
                height: auto;
                margin-bottom: 15px;
            }

        .product-name {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 10px;
            color: #333; /* Thêm màu chữ */
        }

        .product-rating {
            color: gold;
            margin-bottom: 10px;
        }

            .product-rating span {
                color: #666; /* Thêm màu chữ */
                font-size: 14px;
            }

        .product-price {
            font-size: 18px;
            font-weight: 700;
            color: black;
        }
    </style>
</head>
<body>

    <header class="site-header">
        <div class="container">
            <div class="header-logo"><a href="/Home/tranghome">TechPhone</a></div>

            <div class="header-search">
                <input type="text" placeholder="Tìm kiếm sản phẩm...">
                <button type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
            </div>

            <nav class="header-nav">
                <ul>
                    <li><a href="/Home/tranghome">Trang Chủ</a></li>
                    <li><a href="/Home/trangphukien" class="active">Sản Phẩm</a></li>
                    <li><a href="#">Khuyến Mãi</a></li>
                    <li><a href="#">Liên Hệ</a></li>
                </ul>

                <div class="header-delivery">
                    <i class="fa-solid fa-location-dot"></i>
                    <div>
                        <span>Giao đến:</span><br>
                        <a href="#" id="delivery-address-link" class="delivery-text" title="Nhấn để thay đổi địa chỉ">Nhập địa chỉ</a>
                    </div>
                </div>
            </nav>

            <div class="header-actions">
                <a href="#" aria-label="Tài khoản"><i class="fa-solid fa-user"></i></a>
                <a href="/Home/tranggiohang" aria-label="Giỏ hàng"><i class="fa-solid fa-cart-shopping"></i></a>
            </div>
        </div>
    </header>

    <main>
        <section class="breadcrumbs">
            <div class="container">
                <ul>
                    <li><a href="/Home/tranghome">Trang chủ</a></li>
                    <li>Phụ kiện</li>
                </ul>
            </div>
        </section>

        <section class="featured-products">
            <div class="container">
                <h2 class="section-title">Phụ Kiện Nổi Bật</h2>
                <div class="product-grid">
                    <a href="/Home/phukien1" class="product-card-link">
                        <div class="product-card">
                            <img src="https://lh3.googleusercontent.com/sKob-9kbhx-swRfcM0iH7ROxyhfLKvqnlRZcK1S56TCRNlws_of0okd5Nj78bel7nhPv67jcRa1CWBDn3nv0fT5rlNYr9jdB=w500-rw" alt="Kính cường lực">
                            <h3 class="product-name">Kính cường lực UNIQ OPTIX iPhone - Chống chói</h3>
                            <div class="product-rating">
                                <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star-half-alt"></i>
                                <span>(10 đánh giá)</span>
                            </div>
                            <p class="product-price">490.000₫</p>
                        </div>
                    </a>

                    <a href="/Home/phukien2" class="product-card-link">
                        <div class="product-card">
                            <img src="https://lh3.googleusercontent.com/lbc-gzc42LcplOIN4nJ8rxal53QYmBJnD2MhkxZNoHpiDTkMIudrpdDv98T2S08k9kOscD5qTrWvInEESu2btO-kjIbHhnNE=w500-rw" alt="Cáp sạc">
                            <h3 class="product-name">Dây cáp sạc Nhanh Volwatt 100W, Type-C to Type-C</h3>
                            <div class="product-rating">
                                <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                                <span>(100 đánh giá)</span>
                            </div>
                            <p class="product-price">90.000₫</p>
                        </div>
                    </a>

                    <a href="/Home/phukien3" class="product-card-link">
                        <div class="product-card">
                            <img src="https://lh3.googleusercontent.com/AZOXrYsmXuyUQYMOkaGJGySQfBJb1JIiNTl9FLRe13WJStZJ9cXT3kUKOictNXFCmAw7GUHNk6YqJdxr3p8G6DFfshp-w1zE6Q=w500-rw" alt="Bộ sạc">
                            <h3 class="product-name">Bộ sạc Nhanh siêu mỏng Volwatt GaN 45W (kèm Cáp)</h3>
                            <div class="product-rating">
                                <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                                <span>(200 đánh giá)</span>
                            </div>
                            <p class="product-price">690.000₫</p>
                        </div>
                    </a>

                    <a href="/Home/phukien4" class="product-card-link">
                        <div class="product-card">
                            <img src="https://lh3.googleusercontent.com/WPu5houlK3XxvobrlIcuPEp-b44q1FI6-28ly3ETvYmdzpuhyMlZO1Qpy89rXhiKtkgXtOdnNIHewAEKXiaCXzLk6zlWwE4=w500-rw" alt="Giá đỡ điện thoại">
                            <h3 class="product-name">Giá đỡ điện thoại Xoay Q10 (màu đen)</h3>
                            <div class="product-rating">
                                <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="far fa-star"></i>
                                <span>(20 đánh giá)</span>
                            </div>
                            <p class="product-price">119.000₫</p>
                        </div>
                    </a>

                    <a href="/Home/phukien5" class="product-card-link">
                        <div class="product-card">
                            <img src="https://lh3.googleusercontent.com/7wWB8Qf7aLXOGrhHoTNKFAzWeGxoXjuxxMEsmIxLZ7Xycl9GpElE7oku2Ekvt5dBAezoZQ62Ip4p4DFfR5LXaxzV3bvM0Kqh=w500-rw" alt="Sạc dự phòng">
                            <h3 class="product-name">Pin sạc dự phòng Magsafe Stargo Star X 10000mAh</h3>
                            <div class="product-rating">
                                <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star-half-alt"></i>
                                <span>(40 đánh giá)</span>
                            </div>
                            <p class="product-price">400.000₫</p>
                        </div>
                    </a>
                </div>
            </div>
        </section>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const addressLink = document.getElementById('delivery-address-link');
            function updateAddress() {
                const newAddress = prompt("Nhập địa chỉ giao hàng:");
                if (newAddress && newAddress.trim() !== '') {
                    addressLink.textContent = newAddress;
                    localStorage.setItem('userDeliveryAddress', newAddress);
                }
            }
            function loadAddress() {
                const saved = localStorage.getItem('userDeliveryAddress');
                if (saved) addressLink.textContent = saved;
            }
            addressLink.addEventListener('click', e => { e.preventDefault(); updateAddress(); });
            loadAddress();
        });
    </script>
</body>
</html>