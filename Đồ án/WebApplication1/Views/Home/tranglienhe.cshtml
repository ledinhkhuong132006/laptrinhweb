<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liên hệ & Hỗ trợ - TechPhone</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            line-height: 1.6;
            background-color: #f4f7f6;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        a {
            text-decoration: none;
            color: white;
        }

        ul {
            list-style: none;
        }

        /* --- CSS CHO HEADER (ĐÃ SỬA CHÍNH XÁC) --- */
        .site-header {
            background-color: black;
            color: white;
            padding: 20px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .site-header .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .header-logo a {
            font-size: 28px;
            font-weight: 700;
            text-transform: uppercase;
        }

        /* ĐÂY LÀ PHẦN ĐÃ SỬA */
        .header-search {
            display: flex;
            border: 1px solid #555; /* Thêm viền */
            border-radius: 20px;
            overflow: hidden;
            background-color: #fff;
        }

        .header-search input {
            border: none;
            padding: 10px 15px;
            font-size: 14px;
            outline: none;
            width: 300px;
            color: #333;
        }

        .header-search button {
            background-color: lightblue; /* Sửa lại màu */
            border: none;
            color: white;
            padding: 0 15px;
            cursor: pointer;
            font-size: 16px;
        }

        .header-nav {
            display: flex;
            align-items: center;
            gap: 35px;
        }

        .header-nav ul {
            display: flex;
            gap: 35px;
        }

        .header-nav a {
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            color: lightgray;
            transition: color 0.3s ease;
        }

        .header-nav a:hover {
            color: white;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 25px;
            font-size: 20px;
        }

        .header-actions a {
            color: white;
            transition: color 0.3s ease;
        }

        .header-actions a:hover {
            color: cornflowerblue;
        }

        .header-delivery {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #ccc;
            border-left: 1px solid #444;
            padding-left: 20px;
        }

        .header-delivery i {
            color: cornflowerblue;
        }

        .header-delivery .delivery-text {
            color: #fff;
            text-decoration: underline;
            cursor: pointer;
        }

        /* --- CSS CHO FORM LIÊN HỆ --- */
        .contact-section {
            padding: 60px 0;
        }

        .contact-container {
            max-width: 1100px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            display: flex;
            flex-wrap: wrap;
        }

        .contact-info {
            background-color: #007bff;
            color: #ffffff;
            padding: 40px;
            flex: 1;
            min-width: 300px;
        }

        .contact-info h2 { font-size: 28px; }

        .info-item {
            display: flex;
            align-items: center;
            margin-top: 25px;
        }

        .info-item .icon {
            width: 20px;
            margin-right: 15px;
        }

        .info-item .icon svg { fill: #ffffff; }

        .info-item a {
            color: #ffffff;
            text-decoration: none;
        }

        .contact-form {
            padding: 40px;
            flex: 2;
            min-width: 320px;
        }

        .contact-form h2 {
            font-size: 28px;
            margin-bottom: 20px;
        }

        .form-group { margin-bottom: 20px; }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 16px;
            box-sizing: border-box;
        }

        .form-group textarea {
            resize: vertical;
            min-height: 120px;
        }

        .submit-btn {
            width: 100%;
            padding: 15px;
            background-color: #007bff;
            color: #ffffff;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
        }

        #form-message {
            margin-top: 15px;
            padding: 10px;
            border-radius: 5px;
            text-align: center;
            display: none;
        }
        #form-message.success {
            background-color: #d4edda;
            color: #155724;
        }
        #form-message.error {
            background-color: #f8d7da;
            color: #721c24;
        }
    </style>
</head>
<body>
    <header class="site-header">
        <div class="container">
            <div class="header-logo"><a href="/Home/tranghome">TechPhone</a></div>
            <div class="header-search">
                <input type="text" placeholder="Tìm kiếm sản phẩm...">
                <button type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
            </div>
            <nav class="header-nav">
                <ul>
                    <li><a href="index.html">Trang Chủ</a></li>
                    <li><a href="product.html">Sản Phẩm</a></li>
                    <li><a href="#">Khuyến Mãi</a></li>
                    <li><a href="#">Liên Hệ</a></li>
                </ul>
                <div class="header-delivery">
                    <i class="fa-solid fa-location-dot"></i>
                    <div>
                        <span>Giao đến:</span><br>
                        <a href="#" id="delivery-address-link" class="delivery-text" title="Nhấn để thay đổi địa chỉ">Nhập địa chỉ</a>
                    </div>
                </div>
            </nav>
            <div class="header-actions">
                <a href="#" aria-label="Tài khoản"><i class="fa-solid fa-user"></i></a>
                <a href="cart.html" aria-label="Giỏ hàng"><i class="fa-solid fa-cart-shopping"></i></a>
            </div>
        </div>
    </header>

    <main>
        <section class="contact-section">
            <div class="contact-container">
                <div class="contact-info">
                    <h2>Thông tin liên hệ</h2>
                    <p>Nếu bạn gặp bất kỳ sự cố nào với sản phẩm, đừng ngần ngại liên hệ với chúng tôi. Đội ngũ TechPhone luôn sẵn sàng hỗ trợ bạn.</p>
                    <div class="info-item">
                        <div class="icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6L304.7 368C234.3 334.7 177.3 277.7 144 207.3L193.3 167c13.7-11.2 18.4-30 11.6-46.3l-40-96z" /></svg></div>
                        <span>Hotline Hỗ Trợ: <a href="tel:19001080">1900.1080</a></span>
                    </div>
                    <div class="info-item">
                        <div class="icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4c0-26.5-21.5-48-48-48H48zM0 176V384c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V176L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z" /></svg></div>
                        <span>Email Hỗ Trợ: <a href="mailto:hotro@techphone.vn">hotro@techphone.vn</a></span>
                    </div>
                    <div class="info-item">
                        <div class="icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512"><path d="M215.7 499.2C267 435 384 279.4 384 192C384 86 298 0 192 0S0 86 0 192c0 87.4 117 243 168.3 307.2c12.3 15.3 35.1 15.3 47.4 0zM192 128a64 64 0 1 1 0 128 64 64 0 1 1 0-128z" /></svg></div>
                        <span>Địa chỉ: 246 CMT8, Phường 9, Q3, TPHCM</span>
                    </div>
                </div>

                <div class="contact-form">
                    <h2>Gửi yêu cầu Hỗ trợ</h2>
                    <form id="support-form" action="#" method="POST">
                        <div class="form-group">
                            <label for="name">Họ và Tên</label>
                            <input type="text" id="name" name="name" required>
                        </div>
                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" name="email" required>
                        </div>
                        <div class="form-group">
                            <label for="message">Mô tả chi tiết sự cố</label>
                            <textarea id="message" name="message" required></textarea>
                        </div>
                        <button type="submit" class="submit-btn">Gửi Yêu Cầu</button>
                        <p id="form-message"></p>
                    </form>
                </div>
            </div>
        </section>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // JAVASCRIPT CHO "GIAO ĐẾN"
            const addressLink = document.getElementById('delivery-address-link');
            if (addressLink) {
                function updateAddress() {
                    const newAddress = prompt("Nhập địa chỉ giao hàng của bạn:");
                    if (newAddress && newAddress.trim() !== '') {
                        addressLink.textContent = newAddress;
                        localStorage.setItem('userDeliveryAddress', newAddress);
                    }
                }
                function loadAddress() {
                    const savedAddress = localStorage.getItem('userDeliveryAddress');
                    if (savedAddress) {
                        addressLink.textContent = savedAddress;
                    }
                }
                addressLink.addEventListener('click', function (e) {
                    e.preventDefault();
                    updateAddress();
                });
                loadAddress();
            }

            // JAVASCRIPT CHO FORM LIÊN HỆ
            const supportForm = document.getElementById('support-form');
            const messageElement = document.getElementById('form-message');

            if (supportForm) {
                supportForm.addEventListener('submit', function (event) {
                    event.preventDefault();
                    const name = document.getElementById('name').value.trim();
                    const email = document.getElementById('email').value.trim();
                    const message = document.getElementById('message').value.trim();

                    if (name === '' || email === '' || message === '') {
                        messageElement.textContent = 'Vui lòng điền đầy đủ các trường bắt buộc.';
                        messageElement.className = 'error';
                        messageElement.style.display = 'block';
                    } else {
                        messageElement.textContent = 'Gửi yêu cầu thành công! Chúng tôi sẽ liên hệ lại sớm.';
                        messageElement.className = 'success';
                        messageElement.style.display = 'block';
                        supportForm.reset();
                        setTimeout(() => { messageElement.style.display = 'none'; }, 5000);
                    }
                });
            }
        });
    </script>
</body>
</html>