@{
    ViewBag.Title = "tranggiohang";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechPhone - Giỏ Hàng</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            line-height: 1.6;
            background-color: #f4f4f4;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        ul {
            list-style: none;
        }

        img {
            max-width: 100%;
            display: block;
        }

        .site-header {
            background-color: black;
            color: white;
            padding: 20px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .site-header .container {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 20px;
            }

        .header-logo a {
            font-size: 28px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: white;
        }

        .header-search {
            display: flex;
            border: 1px solid #555;
            border-radius: 20px;
            overflow: hidden;
            background-color: #fff;
        }

            .header-search input {
                border: none;
                padding: 10px 15px;
                font-size: 14px;
                outline: none;
                width: 300px;
                color: #333;
            }

            .header-search button {
                background-color: lightblue;
                border: none;
                color: white;
                padding: 0 15px;
                cursor: pointer;
                font-size: 16px;
            }

        .header-nav ul {
            display: flex;
            gap: 35px;
        }

        .header-nav a {
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            color: lightgray;
            transition: color 0.3s ease;
        }

            .header-nav a:hover {
                color: white;
            }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 25px;
            font-size: 20px;
        }

            .header-actions a {
                color: white;
                transition: color 0.3s ease;
            }

                .header-actions a:hover {
                    color: lightblue;
                }

        .btn-primary {
            display: inline-block;
            background-color: lightblue;
            color: white;
            padding: 12px 25px;
            text-transform: uppercase;
            font-weight: 600;
            font-size: 14px;
            border-radius: 3px;
            transition: background-color 0.3s ease;
            border: none;
            cursor: pointer;
            text-align: center;
            width: 100%;
        }

            .btn-primary:hover {
                background-color: deepskyblue;
            }

        .breadcrumbs {
            padding: 20px 0;
            background-color: #fff;
            border-bottom: 1px solid #e9e9e9;
        }

            .breadcrumbs ul {
                display: flex;
                gap: 10px;
                font-size: 14px;
            }

            .breadcrumbs a {
                color: lightblue;
            }

            .breadcrumbs li:not(:last-child)::after {
                content: '/';
                margin-left: 10px;
                color: #999;
            }

        .cart-section {
            padding: 40px 0;
        }

            .cart-section h1 {
                font-size: 28px;
                margin-bottom: 30px;
            }

        .cart-container {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 30px;
            align-items: flex-start;
        }

        .cart-items-list {
            background-color: #fff;
            padding: 20px;
            border-radius: 5px;
        }

        .cart-item {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 20px 0;
            border-bottom: 1px solid #e9e9e9;
        }

            .cart-item:last-child {
                border-bottom: none;
            }

        .cart-item-image img {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 4px;
        }

        .cart-item-details {
            flex-grow: 1;
        }

        .product-name {
            font-weight: 600;
            font-size: 16px;
            margin-bottom: 5px;
        }

        .product-options-text {
            font-size: 13px;
            color: #777;
        }

        .cart-item-price, .cart-item-total {
            font-weight: 600;
            width: 120px;
            text-align: right;
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

            .quantity-selector button {
                background: #f5f5f5;
                border: none;
                width: 30px;
                height: 30px;
                font-size: 18px;
                cursor: pointer;
            }

            .quantity-selector input {
                width: 40px;
                height: 30px;
                text-align: center;
                border: none;
                border-left: 1px solid #ccc;
                border-right: 1px solid #ccc;
                font-size: 14px;
                -moz-appearance: textfield;
            }

        .cart-item-remove button {
            background: none;
            border: none;
            color: #999;
            font-size: 18px;
            cursor: pointer;
            transition: color 0.3s ease;
        }

            .cart-item-remove button:hover {
                color: #e53935;
            }

        .order-summary {
            background-color: #fff;
            padding: 20px;
            border-radius: 5px;
            position: sticky;
            top: 120px;
        }

            .order-summary h2 {
                font-size: 20px;
                margin-bottom: 20px;
                border-bottom: 1px solid #e9e9e9;
                padding-bottom: 15px;
            }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            font-size: 15px;
        }

        #summary-total {
            font-weight: 700;
            font-size: 18px;
            padding-top: 15px;
            border-top: 1px solid #e9e9e9;
            color: red;
        }

            #summary-total .value {
                font-size: 22px;
            }

        .empty-cart-message {
            text-align: center;
            padding: 50px;
            background-color: #fff;
            border-radius: 5px;
        }
    </style>
</head>
<body>

    <header class="site-header">
        <div class="container">
            <div class="header-logo">
                <a href="#">TechPhone</a>
            </div>
            <div class="header-search">
                <input type="text" placeholder="Tìm kiếm sản phẩm...">
                <button type="submit"><i class="fas fa-search"></i></button>
            </div>
            <nav class="header-nav">
                <ul>
                    <li><a href="#">Trang Chủ</a></li>
                    <li><a href="#">Sản Phẩm</a></li>
                    <li><a href="#">Khuyến Mãi</a></li>
                    <li><a href="#">Liên Hệ</a></li>
                </ul>
            </nav>
            <div class="header-actions">
                <a href="#" aria-label="Tài khoản"><i class="fas fa-user"></i></a>
                <a href="#" aria-label="Giỏ hàng"><i class="fas fa-shopping-cart"></i></a>
            </div>
        </div>
    </header>

    <main>
        <section class="breadcrumbs">
            <div class="container">
                <ul>
                    <li><a href="#">Trang chủ</a></li>
                    <li>Giỏ hàng</li>
                </ul>
            </div>
        </section>

        <section class="cart-section">
            <div class="container" id="cart-wrapper">
                <h1>Giỏ Hàng Của Bạn</h1>

                <div class="cart-container" id="cart-main-view">
                    <div class="cart-items-list" id="cart-items-container">
                    </div>

                    <div class="order-summary">
                        <h2>Tóm Tắt Đơn Hàng</h2>
                        <div class="summary-row">
                            <span>Tạm tính</span>
                            <span class="value" id="summary-subtotal">0₫</span>
                        </div>
                        <div class="summary-row">
                            <span>Phí vận chuyển</span>
                            <span class="value" id="summary-shipping">Miễn phí</span>
                        </div>
                        <div class="summary-row" id="summary-total">
                            <span>Tổng cộng</span>
                            <span class="value" id="summary-total-value">0₫</span>
                        </div>
                        <button class="btn-primary" onclick="goToShipping()">Tiến hành đặt hàng</button>
                    </div>
                </div>

                <div class="empty-cart-message" id="empty-cart-view" style="display: none;">
                    <h2>Giỏ hàng của bạn đang trống</h2>
                    <p>Hãy quay lại trang sản phẩm để lựa chọn nhé!</p>
                </div>
            </div>
        </section>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            let cartData = JSON.parse(localStorage.getItem("cart")) || [];

            const cartItemsContainer = document.getElementById('cart-items-container');
            const subtotalEl = document.getElementById('summary-subtotal');
            const totalEl = document.getElementById('summary-total-value');
            const cartMainView = document.getElementById('cart-main-view');
            const emptyCartView = document.getElementById('empty-cart-view');

            function formatPrice(number) {
                return number.toLocaleString('vi-VN') + '₫';
            }

            function renderCart() {
                if (cartData.length === 0) {
                    cartMainView.style.display = 'none';
                    emptyCartView.style.display = 'block';
                    return;
                } else {
                    cartMainView.style.display = 'grid';
                    emptyCartView.style.display = 'none';
                }

                cartItemsContainer.innerHTML = '';

                cartData.forEach((item, index) => {
                    const itemTotalPrice = item.price * (item.quantity || 1);
                    const cartItemHTML = `
                                            <div class="cart-item" data-id="${index}">
                                                <div class="cart-item-image">
                                                    <img src="${item.image}" alt="${item.name}">
                                                </div>
                                                <div class="cart-item-details">
                                                    <p class="product-name">${item.name}</p>
                                                    ${item.color || item.storage ? `<p class="product-options-text">Màu: ${item.color || ''}, Dung lượng: ${item.storage || ''}</p>` : ''}
                                                </div>
                                                <div class="cart-item-price">${formatPrice(item.price)}</div>
                                                <div class="cart-item-quantity">
                                                    <div class="quantity-selector">
                                                        <button class="decrease-qty" data-id="${index}">-</button>
                                                        <input type="number" class="quantity-input" value="${item.quantity || 1}" min="1" data-id="${index}">
                                                        <button class="increase-qty" data-id="${index}">+</button>
                                                    </div>
                                                </div>
                                                <div class="cart-item-total">${formatPrice(itemTotalPrice)}</div>
                                                <div class="cart-item-remove">
                                                    <button class="remove-btn" data-id="${index}"><i class="fas fa-trash-alt"></i></button>
                                                </div>
                                            </div>
                                        `;
                    cartItemsContainer.insertAdjacentHTML('beforeend', cartItemHTML);
                });

                updateSummary();
                attachEventListeners();
            }

            function updateSummary() {
                const subtotal = cartData.reduce((sum, item) => sum + (item.price * (item.quantity || 1)), 0);
                const shipping = 0;
                const total = subtotal + shipping;

                subtotalEl.textContent = formatPrice(subtotal);
                totalEl.textContent = formatPrice(total);
            }

            function attachEventListeners() {
                cartItemsContainer.addEventListener('click', function (event) {
                    const target = event.target;
                    const parentItem = target.closest('.cart-item');
                    if (!parentItem) return;

                    const itemId = parseInt(parentItem.dataset.id);

                    if (target.classList.contains('decrease-qty')) {
                        updateQuantity(itemId, -1);
                    }
                    if (target.classList.contains('increase-qty')) {
                        updateQuantity(itemId, 1);
                    }
                    if (target.closest('.remove-btn')) {
                        removeItem(itemId);
                    }
                });

                cartItemsContainer.addEventListener('input', function (event) {
                    if (event.target.classList.contains('quantity-input')) {
                        const itemId = parseInt(event.target.dataset.id);
                        let newQuantity = parseInt(event.target.value);
                        if (isNaN(newQuantity) || newQuantity < 1) {
                            newQuantity = 1;
                        }
                        updateQuantity(itemId, newQuantity, true);
                    }
                });
            }

            function updateQuantity(itemId, change, isDirectSet = false) {
                const item = cartData[itemId];
                if (item) {
                    if (isDirectSet) {
                        item.quantity = change;
                    } else {
                        item.quantity = (item.quantity || 1) + change;
                    }

                    if (item.quantity < 1) {
                        item.quantity = 1;
                    }
                    localStorage.setItem("cart", JSON.stringify(cartData));
                    renderCart();
                }
            }

            function removeItem(itemId) {
                cartData.splice(itemId, 1);
                localStorage.setItem("cart", JSON.stringify(cartData));
                renderCart();
            }

            renderCart();

        });
    </script>
    <script>
        function goToShipping() {
            const cart = JSON.parse(localStorage.getItem("cart")) || [];
            if (cart.length === 0) {
                alert("Giỏ hàng trống, vui lòng chọn sản phẩm trước!");
                return;
            }
            window.location.href = "/Home/tranggiao";
        }
    </script>
</body>
</html>