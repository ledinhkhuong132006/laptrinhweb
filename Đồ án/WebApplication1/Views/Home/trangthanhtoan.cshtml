@{
    ViewBag.Title = "trangthanhtoan";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thanh toán - TechPhone</title>
    <link rel="stylesheet" href="assets/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f5f5f7;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        ul {
            list-style: none;
        }

        .progress {
            padding: 20px 0;
            background-color: #fff;
            border-bottom: 1px solid #e9e9e9;
        }

            .progress ul {
                display: flex;
                gap: 10px;
                font-size: 14px;
            }

            .progress a {
                color: lightblue;
            }

            .progress li:not(:last-child)::after {
                content: '/';
                margin-left: 10px;
                color: #999;
            }

        .active {
            color: #0071e3;
            font-weight: bold;
        }

        #container {
            max-width: 900px;
            margin: 40px auto;
            background: white;
            border-radius: 12px;
            padding: 30px 40px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        h2 {
            text-align: center;
            margin-bottom: 25px;
            color: #333;
        }

        .payment-methods {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
        }

        .method {
            flex: 1 1 30%;
            background: #fafafa;
            margin: 10px;
            padding: 20px;
            border-radius: 10px;
            border: 2px solid transparent;
            text-align: center;
            cursor: pointer;
            transition: 0.3s;
        }

            .method:hover {
                border-color: #0071e3;
            }

            .method.selected {
                border-color: #0071e3;
                background: #e6f3ff;
            }

            .method i {
                font-size: 36px;
                color: #0071e3;
                margin-bottom: 10px;
            }

        .summary {
            margin-top: 30px;
            padding: 20px;
            background: #f9f9f9;
            border-radius: 8px;
        }

            .summary p {
                display: flex;
                justify-content: space-between;
                font-size: 16px;
                margin: 8px 0;
            }

                .summary p.total {
                    font-weight: 600;
                    font-size: 18px;
                    border-top: 1px solid #ddd;
                    padding-top: 10px;
                }

        .btn {
            background-color: #0071e3;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 6px;
            font-size: 15px;
            cursor: pointer;
            transition: 0.3s;
            width: 100%;
            margin-top: 20px;
        }

            .btn:hover {
                background-color: #005bb5;
            }
    </style>
</head>
<body>
    <main>
        <section class="progress">
            <ul>
                <li><a href="/Home/tranggiohang">Giỏ hàng</a></li>
                <li><a href="/Home/tranggiao">Thông tin</a></li>
                <li>Thanh toán</li>
            </ul>
        </section>

        <div id="container">
            <h2>Chọn phương thức thanh toán</h2>

            <div class="payment-methods">
                <div class="method" onclick="selectMethod(this, 'card')">
                    <i class="fas fa-credit-card"></i>
                    <h3>Thẻ tín dụng/ghi nợ</h3>
                    <p>Visa, Mastercard, JCB</p>
                </div>
                <div class="method" onclick="selectMethod(this, 'bank')">
                    <i class="fas fa-university"></i>
                    <h3>Chuyển khoản ngân hàng</h3>
                    <p>TechPhone Bank - 123456789</p>
                </div>
                <div class="method" onclick="selectMethod(this, 'cod')">
                    <i class="fas fa-money-bill-wave"></i>
                    <h3>Thanh toán khi nhận hàng</h3>
                    <p>Thanh toán bằng tiền mặt</p>
                </div>
            </div>

            <div class="summary" id="order-summary">
                <h3>Tóm tắt đơn hàng</h3>
                <div id="products-list"></div>
                <p><span>Phí giao hàng:</span> <span id="shipping-fee">0₫</span></p>
                <p class="total"><span>Tổng cộng:</span> <span id="total-amount">0₫</span></p>
            </div>

            <button type="button" class="btn" onclick="confirmOrder()">Xác nhận đơn hàng</button>
        </div>
    </main>

    <script>
        let selectedPayment = '';

        function selectMethod(element, type) {
            document.querySelectorAll('.method').forEach(m => m.classList.remove('selected'));
            element.classList.add('selected');
            selectedPayment = type;
        }

        function displayOrderSummary() {
            const cart = JSON.parse(localStorage.getItem('cart')) || [];
            const shippingInfo = JSON.parse(localStorage.getItem('shippingInfo')) || {};
            const productsList = document.getElementById('products-list');
            const shippingFeeEl = document.getElementById('shipping-fee');
            const totalEl = document.getElementById('total-amount');

            if (cart.length === 0) {
                productsList.innerHTML = '<p>Giỏ hàng trống!</p>';
                return;
            }

            let subtotal = 0;
            let productsHTML = '';
            cart.forEach(item => {
                const itemTotal = item.price * (item.quantity || 1);
                subtotal += itemTotal;
                productsHTML += `<p><span>${item.name} (${item.quantity || 1})</span> <span>${(item.price).toLocaleString('vi-VN')}₫</span></p>`;
                const shippingHTML = shippingInfo.name ? `<p><span>Người nhận: ${shippingInfo.name}</span> <span>${shippingInfo.phone}</span></p>` : '';
                productsList.innerHTML += shippingHTML;
            });
            productsList.innerHTML = productsHTML;

            let shippingFee = 0;
            if (shippingInfo.method && shippingInfo.method.includes('Giao nhanh')) {
                shippingFee = 50000;
            }
            shippingFeeEl.textContent = formatPrice(shippingFee);

            const total = subtotal + shippingFee;
            totalEl.textContent = formatPrice(total);
        }

        function formatPrice(number) {
            return number.toLocaleString('vi-VN') + '₫';
        }

        function confirmOrder() {
            if (!selectedPayment) {
                alert("Vui lòng chọn phương thức thanh toán!");
                return;
            }
            localStorage.setItem('paymentMethod', selectedPayment);
            window.location.href = "/Home/trangxacnhan";
        }

        document.addEventListener('DOMContentLoaded', displayOrderSummary);
    </script>
</body>
</html>