
@{
    ViewBag.Title = "Lịch sử mua hàng";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechPhone - Lịch sử mua hàng</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            line-height: 1.6;
            background-color: #f4f4f4;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        ul {
            list-style: none;
        }

        .site-header {
            background-color: black;
            color: white;
            padding: 20px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .site-header .container {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 20px;
            }

        .header-logo a {
            font-size: 28px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: white;
        }

        .header-search {
            display: flex;
            border: 1px solid #555;
            border-radius: 20px;
            overflow: hidden;
            background-color: #fff;
        }

            .header-search input {
                border: none;
                padding: 10px 15px;
                font-size: 14px;
                outline: none;
                width: 300px;
                color: #333;
            }

            .header-search button {
                background-color: lightblue;
                border: none;
                color: white;
                padding: 0 15px;
                cursor: pointer;
                font-size: 16px;
            }

        .header-nav ul {
            display: flex;
            gap: 35px;
        }

        .header-nav a {
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            color: lightgray;
            transition: color 0.3s ease;
        }

            .header-nav a:hover {
                color: white;
            }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 25px;
            font-size: 20px;
        }

            .header-actions a {
                color: white;
                transition: color 0.3s ease;
            }

                .header-actions a:hover {
                    color: lightblue;
                }

        .btn-primary {
            display: inline-block;
            background-color: lightblue;
            color: white;
            padding: 12px 25px;
            text-transform: uppercase;
            font-weight: 600;
            font-size: 14px;
            border-radius: 3px;
            transition: background-color 0.3s ease;
            border: none;
            cursor: pointer;
            text-align: center;
            width: 100%;
        }

            .btn-primary:hover {
                background-color: deepskyblue;
            }

        .breadcrumbs {
            padding: 20px 0;
            background-color: #fff;
            border-bottom: 1px solid #e9e9e9;
        }

            .breadcrumbs ul {
                display: flex;
                gap: 10px;
                font-size: 14px;
            }

            .breadcrumbs a {
                color: lightblue;
            }

            .breadcrumbs li:not(:last-child)::after {
                content: '/';
                margin-left: 10px;
                color: #999;
            }

        .history-section {
            padding: 40px 0;
        }

            .history-section h1 {
                font-size: 28px;
                margin-bottom: 30px;
                text-align: center;
            }

        .orders-list {
            background-color: #fff;
            border-radius: 5px;
            overflow: hidden;
        }

        .order-item {
            border-bottom: 1px solid #e9e9e9;
            padding: 20px;
        }

            .order-item:last-child {
                border-bottom: none;
            }

        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .order-id {
            font-weight: 600;
            color: #333;
        }

        .order-status {
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-pending {
            background-color: #fff3cd;
            color: #856404;
        }

        .status-shipped {
            background-color: #d1ecf1;
            color: #0c5460;
        }

        .status-delivered {
            background-color: #d4edda;
            color: #155724;
        }

        .order-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 10px;
            font-size: 14px;
            color: #666;
        }

        .order-total {
            font-weight: 600;
            color: #333;
            text-align: right;
        }

        .empty-history {
            text-align: center;
            padding: 50px;
            color: #999;
        }

            .empty-history i {
                font-size: 48px;
                margin-bottom: 20px;
                color: #ddd;
            }
    </style>
</head>
<body>

    <header class="site-header">
        <div class="container">
            <div class="header-logo">
                <a href="/Home/Index">TechPhone</a>
            </div>
            <div class="header-search">
                <input type="text" placeholder="Tìm kiếm sản phẩm...">
                <button type="submit"><i class="fas fa-search"></i></button>
            </div>
            <nav class="header-nav">
                <ul>
                    <li><a href="/Home/Index">Trang Chủ</a></li>
                    <li><a href="#">Sản Phẩm</a></li>
                    <li><a href="#">Khuyến Mãi</a></li>
                    <li><a href="#">Liên Hệ</a></li>
                </ul>
            </nav>
            <div class="header-actions">
                <a href="#" aria-label="Tài khoản"><i class="fas fa-user"></i></a>
                <a href="#" aria-label="Giỏ hàng"><i class="fas fa-shopping-cart"></i></a>
            </div>
        </div>
    </header>

    <main>
        <section class="breadcrumbs">
            <div class="container">
                <ul>
                    <li><a href="/Home/Index">Trang chủ</a></li>
                    <li><a href="#">Tài khoản</a></li>
                    <li>Lịch sử mua hàng</li>
                </ul>
            </div>
        </section>

        <section class="history-section">
            <div class="container">
                <h1>Lịch sử mua hàng</h1>

                <div class="orders-list" id="orders-container">
                </div>

                <div class="empty-history" id="empty-history" style="display: none;">
                    <i class="fas fa-shopping-bag"></i>
                    <h2>Chưa có đơn hàng nào</h2>
                    <p>Bạn chưa mua sắm gì cả. Hãy <a href="/Home/Index">mua sắm ngay</a>!</p>
                </div>
            </div>
        </section>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const user = JSON.parse(localStorage.getItem('user')) || {};
            const ordersContainer = document.getElementById('orders-container');
            const emptyHistory = document.getElementById('empty-history');

            let orders = [
                {
                    id: '#123456',
                    date: '2025-10-10',
                    status: 'delivered',
                    total: 28990000,
                    items: [
                        { name: 'iPhone 15 Pro 256GB', quantity: 1, price: 28990000 }
                    ]
                },
                {
                    id: '#789012',
                    date: '2025-10-05',
                    status: 'shipped',
                    total: 32000000,
                    items: [
                        { name: 'Galaxy S25 Ultra 256GB', quantity: 1, price: 32000000 }
                    ]
                }
            ];

            if (orders.length === 0 || !user.loggedIn) {
                ordersContainer.style.display = 'none';
                emptyHistory.style.display = 'block';
                return;
            }

            ordersContainer.innerHTML = '';
            orders.forEach(order => {
                const statusClass = order.status === 'delivered' ? 'status-delivered' : order.status === 'shipped' ? 'status-shipped' : 'status-pending';
                const statusText = order.status === 'delivered' ? 'Đã giao' : order.status === 'shipped' ? 'Đang giao' : 'Chờ xử lý';

                let itemsHTML = '';
                order.items.forEach(item => {
                    itemsHTML += `<p>${item.name} (x${item.quantity}) - ${item.price.toLocaleString('vi-VN')}₫</p>`;
                });

                const orderHTML = `
                        <div class="order-item">
                            <div class="order-header">
                                <span class="order-id">Đơn hàng ${order.id}</span>
                                <span class="order-status ${statusClass}">${statusText}</span>
                            </div>
                            <div class="order-details">
                                <p><strong>Ngày đặt:</strong> ${order.date}</p>
                                <div class="order-items">${itemsHTML}</div>
                                <p class="order-total">Tổng: ${order.total.toLocaleString('vi-VN')}₫</p>
                            </div>
                        </div>
                    `;
                ordersContainer.insertAdjacentHTML('beforeend', orderHTML);
            });
        });
    </script>
</body>
</html>