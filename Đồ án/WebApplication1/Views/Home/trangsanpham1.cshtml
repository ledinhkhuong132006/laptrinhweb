    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const mainImage = document.getElementById('main-product-image');
            const thumbnailsContainer = document.getElementById('product-thumbnails');

            function updateMainImage(thumbnailSrc) {
                mainImage.src = thumbnailSrc;
                document.querySelectorAll('.product-thumbnails img').forEach(t => t.classList.remove('active'));
                const activeThumb = document.querySelector(`.product-thumbnails img[src="${thumbnailSrc}"]`);
                if (activeThumb) {
                    activeThumb.classList.add('active');
                }
            }

            function renderThumbnails(imageUrls, selectedColor) {
                thumbnailsContainer.innerHTML = '';
                imageUrls.forEach((url, index) => {
                    const img = document.createElement('img');
                    img.src = url;
                    img.alt = `Thumbnail ${index + 1} - ${selectedColor}`;
                    img.setAttribute('data-color', selectedColor);

                    if (index === 0) {
                        mainImage.src = url;
                        img.classList.add('active');
                    }

                    img.classList.add('active-color');
                    img.addEventListener('click', function () {
                        updateMainImage(this.src);
                    });
                    thumbnailsContainer.appendChild(img);
                });
            }

            function handleOptionSelection(containerId) {
                const optionsContainer = document.getElementById(containerId);
                if (optionsContainer) {
                    const optionButtons = optionsContainer.querySelectorAll('.option-btn');
                    optionButtons.forEach(button => {
                        button.addEventListener('click', function () {
                            optionButtons.forEach(btn => btn.classList.remove('active'));
                            this.classList.add('active');

                            if (containerId === 'color-options') {
                                const selectedColor = this.dataset.value;
                                const imageUrls = JSON.parse(this.dataset.images);
                                renderThumbnails(imageUrls, selectedColor);

                                document.querySelector('.product-info h1').textContent = `iPhone 15 Pro 256GB - Titan ${selectedColor === 'Blue' ? 'Xanh' : selectedColor === 'Natural' ? 'Tự nhiên' : selectedColor === 'White' ? 'Trắng' : 'Đen'}`;
                            }
                        });
                    });
                }
            }
            handleOptionSelection('color-options');
            handleOptionSelection('storage-options');

            const priceElement = document.querySelector('.product-info .product-price');
            const qtyInput = document.getElementById('quantity-input');
            const decreaseBtn = document.getElementById('decrease-qty');
            const increaseBtn = document.getElementById('increase-qty');
            const subtotalElement = document.getElementById('subtotal-price');

            function parsePrice(priceString) {
                if (!priceString) return 0;
                const numberString = priceString.replace(/₫/g, '').replace(/\./g, '');
                return parseInt(numberString, 10);
            }

            function formatPrice(number) {
                return number.toLocaleString('vi-VN') + '₫';
            }

            function updateSubtotal() {
                const basePriceString = priceElement.textContent;
                const basePrice = parsePrice(basePriceString);
                const quantity = parseInt(qtyInput.value);
                const subtotal = basePrice * quantity;
                subtotalElement.textContent = formatPrice(subtotal);
            }

            decreaseBtn.addEventListener('click', () => {
                let currentValue = parseInt(qtyInput.value);
                if (currentValue > 1) {
                    qtyInput.value = currentValue - 1;
                    updateSubtotal();
                }
            });

            increaseBtn.addEventListener('click', () => {
                let currentValue = parseInt(qtyInput.value);
                qtyInput.value = currentValue + 1;
                updateSubtotal();
            });

            qtyInput.addEventListener('input', () => {
                if (parseInt(qtyInput.value) < 1 || isNaN(parseInt(qtyInput.value))) {
                    qtyInput.value = 1;
                }
                updateSubtotal();
            });

            const tabLinks = document.querySelectorAll('.tab-link');
            const tabContents = document.querySelectorAll('.tab-content');

            tabLinks.forEach(link => {
                link.addEventListener('click', function () {
                    const tabId = this.dataset.tab;
                    tabLinks.forEach(l => l.classList.remove('active'));
                    this.classList.add('active');
                    tabContents.forEach(content => {
                        if (content.id === tabId) {
                            content.classList.add('active');
                        } else {
                            content.classList.remove('active');
                        }
                    });
                });
            });

            updateSubtotal();
            const initialColorButton = document.querySelector('#color-options .option-btn.active');
            if (initialColorButton) {
                const initialImages = JSON.parse(initialColorButton.dataset.images);
                renderThumbnails(initialImages, initialColorButton.dataset.value);
            }
        });
    </script>
    <script>
        window.onload = function () {
            const productData = JSON.parse(localStorage.getItem('selectedProduct'));
            if (productData) {
                document.getElementById('productName').textContent = productData.name;
                document.getElementById('productPrice').textContent = productData.price;
                document.getElementById('productImage').src = productData.image;
            }
        };
    </script>


    <script>
        function addToCart() {
            const productName = document.querySelector('.product-info h1').textContent;
            const basePriceString = document.querySelector('.product-price').textContent;
            const basePrice = parsePrice(basePriceString);
            const quantity = parseInt(document.getElementById('quantity-input').value);
            const selectedColorButton = document.querySelector('#color-options .option-btn.active');
            const selectedStorageButton = document.querySelector('#storage-options .option-btn.active');
            const selectedImage = document.getElementById('main-product-image').src;

            const colorValue = selectedColorButton ? selectedColorButton.dataset.value : 'Blue';
            const storageValue = selectedStorageButton ? selectedStorageButton.dataset.value : '256GB';

            const product = {
                name: productName,
                price: basePrice,
                image: selectedImage,
                color: colorValue,
                storage: storageValue,
                quantity: quantity
            };

            let cart = JSON.parse(localStorage.getItem("cart")) || [];
            cart.push(product);
            localStorage.setItem("cart", JSON.stringify(cart));

            window.location.href = "/Home/tranggiohang";
        }

        function parsePrice(priceString) {
            if (!priceString) return 0;
            const numberString = priceString.replace(/₫/g, '').replace(/\./g, '');
            return parseInt(numberString, 10);
        }
    </script>

