@{
    ViewBag.Title = "trangsanpham1";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi tiết sản phẩm - iPhone 15 Pro</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            line-height: 1.6;
            background-color: white;
            color: black;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        ul {
            list-style: none;
        }

        img {
            max-width: 100%;
            display: block;
        }

        .site-header {
            background-color: black;
            color: white;
            padding: 20px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .site-header .container {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 20px;
            }

        .header-logo a {
            font-size: 28px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: white;
        }

        .header-search {
            display: flex;
            border: 1px solid #555;
            border-radius: 20px;
            overflow: hidden;
            background-color: white;
        }

            .header-search input {
                border: none;
                padding: 10px 15px;
                font-size: 14px;
                outline: none;
                width: 300px;
                color: darkgray;
            }

            .header-search button {
                background-color: lightblue;
                border: none;
                color: white;
                padding: 0 15px;
                cursor: pointer;
                font-size: 16px;
            }

        .header-nav {
            display: flex;
            align-items: center;
            gap: 35px;
        }

            .header-nav ul {
                display: flex;
                gap: 35px;
            }

            .header-nav a {
                font-size: 14px;
                font-weight: 600;
                text-transform: uppercase;
                color: lightgray;
                padding: 5px 0;
                transition: color 0.3s ease;
            }

                .header-nav a:hover, .header-nav a.active {
                    color: white;
                }

        .header-delivery {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #ccc;
            border-left: 1px solid #444;
            padding-left: 20px;
        }

            .header-delivery i {
                color: lightblue;
            }

            .header-delivery .delivery-text {
                color: white;
                text-decoration: underline;
                cursor: pointer;
            }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 25px;
            font-size: 20px;
        }

            .header-actions a {
                color: white;
                transition: color 0.3s ease;
            }

                .header-actions a:hover {
                    color: lightblue;
                }

        .btn-primary {
            display: inline-block;
            background-color: lightblue;
            color: white;
            padding: 12px 25px;
            text-transform: uppercase;
            font-weight: 600;
            font-size: 14px;
            border-radius: 3px;
            transition: background-color 0.3s ease;
            border: none;
            cursor: pointer;
        }

            .btn-primary:hover {
                background-color: deepskyblue;
            }

        .breadcrumbs {
            padding: 20px 0;
            background-color: white;
            border-bottom: 1px solid #e9e9e9;
        }

            .breadcrumbs ul {
                display: flex;
                gap: 10px;
                font-size: 14px;
            }

            .breadcrumbs a {
                color: lightblue;
            }

            .breadcrumbs li:not(:last-child)::after {
                content: '/';
                margin-left: 10px;
                color: #999;
            }

        .product-detail-section {
            padding: 40px 0;
            background-color: white;
        }

        .product-detail-container {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 50px;
            align-items: flex-start;
        }

        .product-images {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .main-image img {
            width: 100%;
            border: 1px solid #e9e9e9;
            border-radius: 5px;
        }

        .product-thumbnails {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 10px;
        }

            .product-thumbnails img {
                border: 2px solid #e9e9e9;
                border-radius: 4px;
                cursor: pointer;
                transition: border-color 0.3s;
                display: none;
            }

                .product-thumbnails img.active-color {
                    display: block;
                }

                .product-thumbnails img:hover, .product-thumbnails img.active {
                    border-color: lightblue;
                }

        .product-info h1 {
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .product-rating {
            color: #f9bf3b;
            margin-bottom: 15px;
        }

        .product-price {
            font-size: 32px;
            font-weight: 700;
            color: red;
            margin-bottom: 20px;
        }

        .product-short-desc {
            margin-bottom: 25px;
            color: #666;
        }

        .product-options .option-group {
            margin-bottom: 20px;
        }

        .option-group h3 {
            font-size: 16px;
            margin-bottom: 10px;
            font-weight: 600;
        }

        .option-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

            .option-buttons .option-btn {
                padding: 8px 15px;
                border: 1px solid;
                border-radius: 20px;
                cursor: pointer;
                transition: all 0.3s;
                font-size: 14px;
                display: flex;
                align-items: center;
            }

                .option-buttons .option-btn:hover {
                    background-color: white;
                    border-color: gray;
                }

                .option-buttons .option-btn.active {
                    background-color: dodgerblue;
                    color: #fff;
                    border-color: dodgerblue;
                }

        .option-btn .color-swatch {
            display: inline-block;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            margin-right: 8px;
            border: 1px solid #ddd;
        }

        .option-btn[data-value="Blue"] .color-swatch {
            background-color: #3B495E;
        }

        .option-btn[data-value="Natural"] .color-swatch {
            background-color: #8A837E;
        }

        .option-btn[data-value="White"] .color-swatch {
            background-color: #F0F0F0;
        }

        .option-btn[data-value="Black"] .color-swatch {
            background-color: #454545;
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            border: 1px solid white;
            border-radius: 5px;
            width: fit-content;
        }

            .quantity-selector button {
                background: white;
                border: none;
                width: 35px;
                height: 35px;
                font-size: 20px;
                cursor: pointer;
            }

            .quantity-selector input {
                width: 50px;
                height: 35px;
                text-align: center;
                border: none;
                border-left: 1px solid white;
                border-right: 1px solid white;
                font-size: 16px;
                -moz-appearance: textfield;
            }

                .quantity-selector input::-webkit-outer-spin-button,
                .quantity-selector input::-webkit-inner-spin-button {
                    -webkit-appearance: none;
                    margin: 0;
                }

        .product-actions {
            margin-top: 30px;
            display: flex;
            gap: 15px;
        }

            .product-actions .btn-primary {
                flex-grow: 1;
                padding: 15px;
                font-size: 16px;
            }

        .product-tabs-section {
            padding: 60px 0;
        }

        .tab-links {
            display: flex;
            border-bottom: 1px solid white;
            margin-bottom: 30px;
        }

        .tab-link {
            padding: 15px 30px;
            cursor: pointer;
            font-size: 18px;
            font-weight: 600;
            color: dimgrey;
            position: relative;
            border-bottom: 3px solid transparent;
            transition: all 0.3s;
        }

            .tab-link.active {
                color: lightblue;
                border-bottom-color: lightblue;
            }

        .tab-content {
            display: none;
        }

            .tab-content.active {
                display: block;
            }

            .tab-content h3 {
                font-size: 20px;
                margin-bottom: 15px;
            }

            .tab-content p, .tab-content li {
                color: black;
                margin-bottom: 10px;
            }

        .specs-table {
            width: 100%;
            border-collapse: collapse;
        }

            .specs-table td {
                padding: 12px;
                border-bottom: 1px solid white;
            }

                .specs-table td:first-child {
                    font-weight: 600;
                    width: 30%;
                    background-color: white;
                }

        .related-products {
            padding-bottom: 60px;
        }

        .section-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 30px;
            text-transform: uppercase;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
        }

        .product-card {
            background-color: white;
            border: 1px solid white;
            padding: 20px;
            text-align: center;
            transition: box-shadow 0.3s ease, transform 0.3s ease;
        }

            .product-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
            }

            .product-card img {
                height: auto;
                margin-bottom: 15px;
            }

        .product-name {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 10px;
            color: black;
        }

        .product-card .product-price {
            font-size: 18px;
            font-weight: 700;
            color: black;
        }

        a.product-card-link {
            text-decoration: none;
        }
    </style>
</head>
<body>

    <header class="site-header">
        <div class="container">
            <div class="header-logo">
                <a href="#">TechPhone</a>
            </div>
            <div class="header-search">
                <input type="text" placeholder="Tìm kiếm sản phẩm...">
                <button type="submit"><i class="fas fa-search"></i></button>
            </div>
            <nav class="header-nav">
                <ul>
                    <li><a href="#">Trang Chủ</a></li>
                    <li><a href="#" class="active">Sản Phẩm</a></li>
                    <li><a href="#">Khuyến Mãi</a></li>
                    <li><a href="#">Liên Hệ</a></li>
                </ul>
            </nav>
            <div class="header-actions">
                <a href="#" aria-label="Tài khoản"><i class="fas fa-user"></i></a>
                <a href="#" aria-label="Giỏ hàng"><i class="fas fa-shopping-cart"></i></a>
            </div>
        </div>
    </header>

    <main>
        <section class="breadcrumbs">
            <div class="container">
                <ul>
                    <li><a href="#">Trang chủ</a></li>
                    <li><a href="#">Điện thoại</a></li>
                    <li>iPhone 15 Pro</li>
                </ul>
            </div>
        </section>

        <section class="product-detail-section">
            <div class="container">
                <div class="product-detail-container">
                    <div class="product-images">
                        <div class="main-image">
                            <img id="main-product-image" src="https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-blue-thumbnew-600x600.jpg" alt="iPhone 15 Pro - Blue">
                        </div>
                        <div class="product-thumbnails" id="product-thumbnails">
                            <img src="https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-blue-thumbnew-600x600.jpg" alt="Thumbnail 1" data-color="Blue" class="active-color active">
                            <img src="https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-blue-1-1.jpg" alt="Thumbnail 2" data-color="Blue" class="active-color">
                            <img src="https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-blue-2.jpg" alt="Thumbnail 3" data-color="Blue" class="active-color">
                            <img src="https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-blue-3.jpg" alt="Thumbnail 4" data-color="Blue" class="active-color">
                            <img src="https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-blue-4.jpg" alt="Thumbnail 5" data-color="Blue" class="active-color">
                        </div>
                    </div>

                    <div class="product-info">

                        <h1>iPhone 15 Pro 256GB - Titan Xanh</h1>
                        <div class="product-rating">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star-half-alt"></i>
                            <span>(125 đánh giá)</span>
                        </div>

                        <p class="product-price">28.990.000₫</p>
                        <p class="product-short-desc">
                            iPhone 15 Pro. Rất bền. Rất nhẹ. Rất Pro. Chip A17 Pro mang đến hiệu năng đồ họa đột phá. Thiết kế từ titan chuẩn hàng không vũ trụ siêu bền, siêu nhẹ.
                        </p>

                        <div class="product-options">
                            <div class="option-group">
                                <h3>Màu sắc:</h3>
                                <div class="option-buttons" id="color-options">
                                    <button class="option-btn active" data-value="Blue"
                                            data-images='[
                                            "https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-blue-thumbnew-600x600.jpg",
                                            "https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-blue-1-1.jpg",
                                            "https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-blue-2.jpg",
                                            "https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-blue-3.jpg",
                                            "https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-blue-4.jpg"
                                        ]'>
                                        <span class="color-swatch"></span>Titan Xanh
                                    </button>
                                    <button class="option-btn" data-value="Natural"
                                            data-images='[
                                            "https://cdn2.cellphones.com.vn/insecure/rs:fill:0:358/q:90/plain/https://cellphones.com.vn/media/catalog/product/i/p/iphone-15-pro-max_4.png",
                                            "https://cdn2.cellphones.com.vn/insecure/rs:fill:0:358/q:90/plain/https://cellphones.com.vn/media/catalog/product/i/p/iphone-15-pro_5__2.jpg",
                                            "https://cdn2.cellphones.com.vn/insecure/rs:fill:0:358/q:90/plain/https://cellphones.com.vn/media/catalog/product/i/p/iphone-15-pro_6__2.jpg",
                                            "https://cdn2.cellphones.com.vn/insecure/rs:fill:0:358/q:90/plain/https://cellphones.com.vn/media/catalog/product/i/p/iphone-15-pro_7__2.jpg",
                                            "https://cdn2.cellphones.com.vn/insecure/rs:fill:0:358/q:90/plain/https://cellphones.com.vn/media/catalog/product/i/p/iphone-15-pro_1__2.jpg"
                                        ]'>
                                        <span class="color-swatch"></span>Titan Tự nhiên
                                    </button>
                                    <button class="option-btn" data-value="White"
                                            data-images='[
                                            "https://cdn.tgdd.vn/Products/Images/42/299033/iphone-15-pro-white-1-750x500.jpg",
                                            "https://cdnv2.tgdd.vn/mwg-static/tgdd/Products/Images/42/299033/iphone-15-pro-titan-trang-2-638629422025682081-750x500.jpg",
                                            "https://cdn.tgdd.vn/Products/Images/42/299033/iphone-15-pro-white-3-750x500.jpg",
                                            "https://cdn.tgdd.vn/Products/Images/42/299033/iphone-15-pro-white-4-750x500.jpg",
                                           "https://cdnv2.tgdd.vn/mwg-static/tgdd/Products/Images/42/299033/iphone-15-pro-titan-trang-2-638629422025682081-750x500.jpg"
                                        ]'>
                                        <span class="color-swatch"></span>Titan Trắng
                                    </button>
                                    <button class="option-btn" data-value="Black"
                                            data-images='[
                                            "https://cdn.tgdd.vn/Products/Images/42/299033/iphone-15-pro-black-1-750x500.jpg",
                                            "https://cdnv2.tgdd.vn/mwg-static/tgdd/Products/Images/42/299033/iphone-15-pro-titan-den-2-638629422268837146-750x500.jpg",
                                            "https://cdn.tgdd.vn/Products/Images/42/299033/iphone-15-pro-black-3-750x500.jpg",
                                            "https://cdn.tgdd.vn/Products/Images/42/299033/iphone-15-pro-black-4-750x500.jpg",
                                       "https://cdnv2.tgdd.vn/mwg-static/tgdd/Products/Images/42/299033/iphone-15-pro-titan-den-2-638629422268837146-750x500.jpg"
                                        ]'>
                                        <span class="color-swatch"></span>Titan Đen
                                    </button>
                                </div>
                            </div>
                            <div class="option-group">
                                <h3>Dung lượng:</h3>
                                <div class="option-buttons" id="storage-options">
                                    <button class="option-btn" data-value="128GB">128GB</button>
                                    <button class="option-btn active" data-value="256GB">256GB</button>
                                    <button class="option-btn" data-value="512GB">512GB</button>
                                    <button class="option-btn" data-value="1TB">1TB</button>
                                </div>
                            </div>
                            <div class="option-group">
                                <h3>Số lượng:</h3>
                                <div class="quantity-selector">
                                    <button id="decrease-qty">-</button>
                                    <input type="number" id="quantity-input" value="1" min="1">
                                    <button id="increase-qty">+</button>
                                </div>
                            </div>
                            <div class="option-group">
                                <h3>Tạm tính:</h3>
                                <p class="product-price" id="subtotal-price" style="font-size: 28px; margin-bottom: 0;">
                                </p>
                            </div>
                        </div>

                        <div class="product-actions">
                            <button class="btn-primary" onclick="addToCart()"><i class="fas fa-cart-plus"></i>Thêm vào giỏ hàng</button>
                            <button class="btn-primary" style="background-color: #e53935;">Mua ngay</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="product-tabs-section">
            <div class="container">
                <div class="tab-links">
                    <div class="tab-link active" data-tab="description">Mô tả sản phẩm</div>
                    <div class="tab-link" data-tab="specs">Thông số kỹ thuật</div>
                    <div class="tab-link" data-tab="reviews">Đánh giá</div>
                </div>

                <div class="tab-content active" id="description">
                    <h3>Thiết kế Titan đột phá</h3>
                    <p>iPhone 15 Pro là iPhone đầu tiên có thiết kế từ titan chuẩn hàng không vũ trụ, sử dụng hợp kim cao cấp tương tự như trong tàu vũ trụ cho các sứ mệnh Sao Hỏa. Titan là một trong những kim loại có tỷ lệ độ bền trên trọng lượng tốt nhất, tạo nên các phiên bản Pro nhẹ nhất từ trước đến nay của chúng tôi. Bạn sẽ cảm nhận được sự khác biệt ngay khi cầm trên tay.</p>
                    <h3>Chip A17 Pro - Quái vật cho game thủ</h3>
                    <p>Đây rồi. Lần tái thiết kế lớn nhất trong lịch sử GPU của Apple. A17 Pro là một đẳng cấp chip iPhone hoàn toàn mới, mang lại hiệu năng đồ họa tốt nhất của chúng tôi, một cách đáng kể. Các game di động sẽ trông và mang lại cảm giác vô cùng sống động, với môi trường cực kỳ chi tiết và các nhân vật chân thực hơn. Với tốc độ và hiệu quả năng lượng dẫn đầu ngành, A17 Pro xử lý cực nhanh.</p>
                </div>

                <div class="tab-content" id="specs">
                    <h3>Thông số kỹ thuật chi tiết</h3>
                    <table class="specs-table">
                        <tbody>
                            <tr>
                                <td>Màn hình</td>
                                <td>OLED, 6.1", Super Retina XDR</td>
                            </tr>
                            <tr>
                                <td>Hệ điều hành</td>
                                <td>iOS 17</td>
                            </tr>
                            <tr>
                                <td>Camera sau</td>
                                <td>Chính 48 MP & Phụ 12 MP, 12 MP</td>
                            </tr>
                            <tr>
                                <td>Camera trước</td>
                                <td>12 MP</td>
                            </tr>
                            <tr>
                                <td>Chip</td>
                                <td>Apple A17 Pro 6 nhân</td>
                            </tr>
                            <tr>
                                <td>RAM</td>
                                <td>8 GB</td>
                            </tr>
                            <tr>
                                <td>Dung lượng lưu trữ</td>
                                <td>256 GB</td>
                            </tr>
                            <tr>
                                <td>SIM</td>
                                <td>1 Nano SIM & 1 eSIM, Hỗ trợ 5G</td>
                            </tr>
                            <tr>
                                <td>Pin, Sạc</td>
                                <td>3274 mAh, 20 W</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="tab-content" id="reviews">
                    <h3>Chưa có đánh giá nào cho sản phẩm này.</h3>
                    <p>Hãy là người đầu tiên đánh giá sản phẩm iPhone 15 Pro!</p>
                </div>
            </div>
        </section>

        <section class="related-products">
            <div class="container">
                <h2 class="section-title">Sản phẩm tương tự</h2>
                <div class="product-grid">
                    <a href="samsung-s25-ultra.html" class="product-card-link">
                        <div class="product-card">
                            <img src="https://cdn2.cellphones.com.vn/insecure/rs:fill:0:358/q:90/plain/https://cellphones.com.vn/media/catalog/product/d/i/dien-thoai-samsung-galaxy-s25-ultra_2__4.png" alt="Phone Model Y">
                            <h3 class="product-name">Galaxy S25 Ultra</h3>
                            <div class="product-rating">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <span>(125 đánh giá)</span>
                            </div>
                            <p class="product-price">32.000.000₫</p>
