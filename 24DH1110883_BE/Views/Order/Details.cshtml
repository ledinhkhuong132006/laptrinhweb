@model _24DH1110883_MyStore.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 30px;">
    <h3>Chi tiết đơn hàng #@Model.OrderID</h3>
    <div class="row">
        <div class="col-md-6">
           
            <p><strong>Ngày đặt:</strong> @string.Format("{0:dd/MM/yyyy}", Model.OrderDate)</p>
            <p><strong>Trạng thái:</strong> </p>
        </div>
        <div class="col-md-6">
            <p><strong>Địa chỉ giao:</strong> @Model.AddressDelivery</p>
        </div>
    </div>

    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Hình ảnh</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detail in Model.OrderDetails)
            {
                <tr>
                    <td>@detail.Product.ProductName</td>
                    <td>
                        
                        <img src="@(detail.Product.ProductImage.Contains("http") ? detail.Product.ProductImage : Url.Content("~/images/products/" + detail.Product.ProductImage))" width="60" />
                    </td>
                    <td>@detail.Quantity</td>

                    
                    <td>@string.Format("{0:N0} đ", detail.UnitPrice)</td>

                 
                    <td>@string.Format("{0:N0} đ", detail.UnitPrice * detail.Quantity)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="4" class="text-right"><strong>Tổng cộng:</strong></td>
                <td style="color:red; font-weight:bold; font-size: 18px;">
                
                    @string.Format("{0:N0} đ", Model.TotalAmount)
                </td>
            </tr>
        </tfoot>
    </table>

    <a href="@Url.Action("History")" class="btn btn-secondary">Quay lại lịch sử</a>
</div>