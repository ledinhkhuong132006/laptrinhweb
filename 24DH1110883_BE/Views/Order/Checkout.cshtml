@model _24DH1110883_MyStore.Models.ViewModel.CheckoutVM

@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 20px; 
margin-bottom: 50px;">
    <h2 style="text-align:center; 
               color:#333;">THÔNG TIN ĐẶT HÀNG</h2>
    <hr />

    @using (Html.BeginForm("Checkout", "Order", FormMethod.Post, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6">
                <h4 style="border-bottom: 1px solid #ccc; padding-bottom: 5px;">Sản phẩm đã chọn</h4>

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Tên SP</th>
                            <th>SL</th>
                            <th>Đơn giá</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                    
                        @foreach (var item in Model.CartItems)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="text-center">@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("N0")</td>
                                <td>@item.TotalPrice.ToString("N0")</td>
                            </tr>
                        }
                        <tr style="font-weight:bold; color:red;">
                            <td colspan="3" style="text-align:right;">TỔNG CỘNG:</td>
                            <td>@Model.TotalAmount.ToString("N0") đ</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="col-md-6">
                <h4 style="border-bottom: 1px solid #ccc; padding-bottom: 5px;">Thông tin giao hàng</h4>

                <div class="form-group">
                    <label>Họ tên người nhận:</label>
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control", @disabled = "disabled" })
                </div>

                <div class="form-group" style="margin-top: 10px;">
                    <label>Ngày đặt hàng:</label>
                    @Html.TextBoxFor(model => model.OrderDate, "{0:yyyy-MM-dd}", new
                    {
                               @class = "form-control",
                               @type = "date",
                               @Value = DateTime.Now.ToString("yyyy-MM-dd"), // ngày hiện tại
                               @readonly = "readonly" 
 })
                </div>

                <div class="form-group" style="margin-top: 10px;">
                    <label style="font-weight:bold;">Địa chỉ giao hàng (*):</label>
                    @Html.TextBoxFor(m => m.ShippingAddress, new { @class = "form-control", @placeholder = "Nhập địa chỉ nhận hàng..." })
                    @Html.ValidationMessageFor(m => m.ShippingAddress, "", new { @class = "text-danger" })
                </div>

                <div class="form-group" style="margin-top: 15px;">
                    <label style="font-weight:bold;">Cách thức giao hàng:</label> <br />

                    <label class="radio-inline">
                        @Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng nhanh", new { @checked = "checked" }) Giao hàng nhanh
                    </label>
                    <br />
                    <label class="radio-inline">
                        @Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng tiết kiệm") Giao hàng tiết kiệm
                    </label>
                </div>

                <div class="form-group" style="margin-top: 15px;">
                    <label style="font-weight:bold;">Hình thức thanh toán:</label> <br />

                    <label>
                        @Html.RadioButtonFor(m => m.PaymentMethod, "Tiền mặt", new { @checked = "checked" })
                        Thanh toán tiền mặt khi nhận hàng (COD)
                    </label>
                    <br />

                
                    <br />

                    <label>
                        @Html.RadioButtonFor(m => m.PaymentMethod, "Mua trước trả sau")
                        Mua trước trả sau
                    </label>
                </div>

                <hr />
                <button type="submit" class="btn btn-primary btn-lg" style="width: 100%;">
                    XÁC NHẬN ĐẶT HÀNG
                </button>
            </div>
        </div>
    }
</div>