@model _24DH1110883_MyStore.Models.ViewModel.ProductDetailsVM
@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerDetailProduct.css" />
    <style>
        /* CSS ẩn nút tăng giảm số lượng mặc định của trình duyệt */
        input[type=number]::-webkit-inner-spin-button,
        input[type=number]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        input[type=number] {
            -moz-appearance: textfield;
        }

        /* CSS để ảnh không bị vỡ */
        .pro-section img {
            max-width: 100%;
            height: auto;
            object-fit: contain;
        }
    </style>
</head>

<div class="container-fluid pro mt-4">
    <div class="row div-horizontal">
       
        <div class="col-md-3 pro-section">
          
            <img src="@(Model.product.ProductImage != null && Model.product.ProductImage.Contains("http") ? Model.product.ProductImage : Url.Content("~/images/products/" + Model.product.ProductImage))"
                 alt="@Model.product.ProductName" />
        </div>

        @*  THÔNG TIN  *@
        <div class="col-md-5 pro-section">
            <h4><strong>@Html.DisplayFor(model => model.product.ProductName)</strong></h4>

            <p class="pro-sale">Đã bán:&nbsp; @Model.product.OrderDetails.Count</p>

            <p class="pro-price" style="color:red; font-size:1.5rem; font-weight:bold;">
                @string.Format("{0:N0} đ", Model.product.ProductPrice)
            </p>

         
            <p class="text-break">
                Danh mục:&nbsp;@Model.product.Category.CategoryName
            </p>

            <hr />

            <h5><strong>Mô tả</strong></h5>
           
            <p class="text-break"> @Model.product.ProductDescription </p>

            <hr />

            @*  sản phẩm liên quan *@
            <div>@Html.Partial("_PVRelatedProduct", Model)</div>
        </div>

        
        <div class="col-md-3 pro-section border-start">
            <div class="form-group p-3">

               
                @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post))
                {
                    <input type="hidden" name="id" value="@Model.product.ProductID" />

                    <h4><strong>Số lượng</strong></h4>
                    <p>
                        @Html.TextBoxFor(model => model.quantity, new
                        {
                            @class = "form-control text-center",
                            @type = "number",
                            @min = 1,
                            @id = "txtQuantity",
                            @oninput = "updateTotalPrice()"
                        })
                    </p>

                    <h4><strong>Tạm tính</strong></h4>
                    <p class="text-danger fw-bold fs-4" id="totalPriceDisplay">
                        @Model.estimatedValue.ToString("N0") đ
                    </p>


                    <div class="d-grid gap-2">
                        
                        <button type="submit" name="type" value="normal" class="btn btn-primary">
                            <i class="fa fa-cart-plus"></i> Thêm vào giỏ
                        </button>

                     
                        <button type="submit" name="type" value="buynow" class="btn btn-danger">
                            <i class="fa fa-check"></i> Mua ngay
                        </button>
                    </div>
                }

                <hr />
            </div>

            @* Khối Top sản phẩm *@
            <div>@Html.Partial("_PVTopProduct", Model)</div>
        </div>
    </div>
</div>

